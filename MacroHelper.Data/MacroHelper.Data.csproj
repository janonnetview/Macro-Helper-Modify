<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.11" />
    <PackageReference Include="Dapper" Version="2.1.66" />

    <!--
      Referência direta a um pacote que já viria de graça pelo Microsoft.Data.Sqlite. Existe por
      um motivo só: o 8.0.11 arrasta o SQLitePCLRaw 2.1.6, e a cópia do SQLite embutida nele tem
      o CVE-2025-6965 (severidade alta, corrigido a partir do 2.1.12). Declarar a versão aqui faz
      o NuGet usar esta em vez da que veio junto — os quatro projetos herdam pela referência a
      este, então é um lugar só.

      Subir o Microsoft.Data.Sqlite resolveria também, mas o 10.x tem como alvo net10.0 e o app
      todo é net8.0-windows. Esta linha sai no dia que a solution mudar de alvo.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- LogicalName explícito: o DatabaseMigrator procura os scripts por esse prefixo.
         Sem ele, renomear a pasta ou o RootNamespace mudaria o nome do recurso e o
         migrator pararia de achar as migrações — em silêncio, sem erro de compilação. -->
    <EmbeddedResource Include="Sql\*.sql" LogicalName="MacroHelper.Data.Sql.%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MacroHelper.Core\MacroHelper.Core.csproj" />
  </ItemGroup>
</Project>
