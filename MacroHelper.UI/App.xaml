<Application x:Class="MacroHelper.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:MacroHelper.UI.Converters"
             xmlns:prim="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- O tema (cor) é trocado em tempo de execução pelo ThemeService, que procura
                     o dicionário cujo Source contém "/Themes/". Os tokens (geometria) ficam
                     fora dessa pasta justamente para nunca entrarem nessa troca. -->
                <ResourceDictionary Source="/Themes/Light.xaml"/>
                <ResourceDictionary Source="/Styles/Tokens.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <conv:StringNullToVisibilityConverter x:Key="NullToVis"/>
            <conv:StringNullToVisibilityConverter x:Key="StringToVis"/>
            <conv:InverseBoolConverter x:Key="InverseBool"/>
            <conv:IntGreaterThanZeroToVisibilityConverter x:Key="IntToVis"/>
            <conv:IntZeroToVisibilityConverter x:Key="IntZeroToVis"/>
            <conv:NameInitialsConverter x:Key="NameInitials"/>
            <conv:HexToBrushConverter x:Key="HexToBrush"/>
            <conv:EqualsToVisibilityConverter x:Key="EqualsToVis"/>
            <conv:StringEqualsToVisibilityConverter x:Key="StringEqualsToVis"/>
            <conv:StringEqualsToBoolConverter x:Key="StringEqualsToBool"/>
            <conv:ObjectNullToVisibilityConverter x:Key="ObjNullToVis"/>
            <conv:NullToBoolConverter x:Key="NullToBool"/>
            <conv:BoolToVisConverter x:Key="BoolToVisConv"/>
            <conv:DataAmigavelConverter x:Key="DataAmigavel"/>
            <conv:DataVencidaConverter x:Key="DataVencida"/>
            <conv:RecorrenciaTextoConverter x:Key="RecorrenciaTexto"/>

            <!--
                ══════════════════════════════════════════════════════════════════════
                COMPONENTES — a linguagem de vidro do SK MacroHelper
                ══════════════════════════════════════════════════════════════════════

                Toda superfície do app é uma destas quatro, e nada mais:

                    SurfaceGlassBrush          repouso   (card, painel, item de lista)
                    SurfaceGlassHoverBrush     hover
                    SurfaceGlassActiveBrush    selecionado / pressionado
                    SurfaceGlassElevatedBrush  o que flutua (herói, janela, popover)

                Raio de canto vem sempre de um dos degraus de Styles/Tokens.xaml. Cor vem
                sempre de um brush do tema. Um componente novo que precise de um número solto
                é sinal de que falta um token, não de que este arquivo precisa de exceção.

                O verde entra em três situações — ação principal, estado ativo e foco. Ícone,
                borda e pílula são monocromáticos.
            -->

            <!-- ══════════════ BOTÕES ══════════════ -->

            <!--
                PRIMÁRIO — o único elemento da tela que pode usar o verde cheio. O texto vem de
                AccentForegroundBrush (e não "White" fixo): o verde da identidade é claro, e
                branco sobre ele não se lê. Quando o usuário troca a cor de destaque nas
                Configurações, o ThemeService recalcula esse par pelo contraste.
            -->
            <Style x:Key="ButtonPrimary" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="22,0"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <!-- O brilho é um DropShadow da cor do accent, não uma segunda
                                     camada de fundo: ele vaza para fora do botão, que é onde a
                                     luz deve estar. -->
                                <Border x:Name="b" Background="{TemplateBinding Background}"
                                        CornerRadius="{StaticResource RadiusMd}"
                                        Padding="{TemplateBinding Padding}">
                                    <Border.Effect>
                                        <DropShadowEffect x:Name="glow" Color="{DynamicResource AccentColor}"
                                                          BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                    </Border.Effect>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Reflexo interno de topo: 1px que separa o botão do fundo sem
                                     precisar de borda. -->
                                <Border Height="1" VerticalAlignment="Top" Margin="10,0"
                                        Background="#38FFFFFF" IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentHoverBrush}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="18" Duration="0:0:0.16"/>
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.40" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <!-- Foco de teclado acende o mesmo halo do hover. Vai por
                                     Storyboard, e não por Setter: um nome dentro de um Effect
                                     não existe para o TargetName de um Setter. -->
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="16" Duration="0:0:0.16"/>
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Opacity" Value="0.82"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.38"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- SECUNDÁRIO — vidro. Sem cor de fundo própria: o que o desenha é o filme
                 translúcido mais uma borda de 1px. -->
            <Style x:Key="ButtonSecondary" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="20,0"/>
                <Setter Property="Height" Value="40"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource RadiusMd}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.38"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- FANTASMA — só texto. Para "Ver todas", "Cancelar" e afins, que hoje viravam
                 links verdes espalhados pela tela. -->
            <Style x:Key="ButtonGhost" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ÍCONE — quadrado transparente. Ganha vidro só no hover. -->
            <Style x:Key="ButtonIconOnly" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Width" Value="34"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusSm}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- BARRA DE FERRAMENTAS — o mesmo botão-ícone, com borda, para quando vários
                 aparecem agrupados. Tag="Active" marca o que está ligado. -->
            <Style x:Key="ToolbarIconButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Width" Value="38"/>
                <Setter Property="Height" Value="38"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource RadiusMd}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="Tag" Value="Active">
                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                    <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════ CAMPOS ══════════════ -->

            <!--
                O campo é a única superfície REBAIXADA do sistema: enquanto card e painel
                clareiam o fundo, o campo escurece. É o que faz "onde eu escrevo" ser óbvio sem
                borda grossa.

                O foco não engorda a borda — trocar 1px por 2px empurra o texto e a tela pisca.
                Quem marca o foco é a cor da borda mais um halo de accent, que é sombra e
                portanto não ocupa layout.
            -->
            <Style x:Key="InputStyle" TargetType="TextBox">
                <!-- Campo de uma linha centraliza o texto; campo de vários (uma nota, uma
                     observação) escreve de cima para baixo, como qualquer editor. Quem decide
                     é o VerticalContentAlignment de cada campo, e o padrão aqui é o caso comum. -->
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <!-- O recuo do texto também é do campo: 14 nas laterais serve quase sempre, e
                     quem tem ícone dentro (a busca das Notas) ou escreve em várias linhas pede
                     o seu. -->
                <Setter Property="Padding"       Value="14,0"/>
                <Setter Property="Background"    Value="{DynamicResource InputBgBrush}"/>
                <Setter Property="Foreground"    Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"   Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize"      Value="13"/>
                <Setter Property="CaretBrush"    Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionOpacity" Value="0.28"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource RadiusMd}" SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="focusGlow" Color="{DynamicResource AccentColor}"
                                                      BlurRadius="0" ShadowDepth="0" Opacity="0"/>
                                </Border.Effect>
                                <!--
                                    O ScrollViewer vem direto, sem nada em volta com
                                    Margin="{TemplateBinding Padding}".

                                    O TextBox já aplica o próprio Padding dentro do
                                    PART_ContentHost; embrulhar num Grid com o Padding de novo
                                    aplicava o recuo DUAS vezes, e o que o campo perdia era
                                    largura de texto. Num campo estreito isso cortava o
                                    conteúdo: o seletor de data ficava com 22px de área útil
                                    para uma data de 66px e mostrava "24/0".
                                -->
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush"
                                            Value="{DynamicResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush"
                                            Value="{DynamicResource InputFocusBorderBrush}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="focusGlow" Storyboard.TargetProperty="BlurRadius" To="12" Duration="0:0:0.16"/>
                                                <DoubleAnimation Storyboard.TargetName="focusGlow" Storyboard.TargetProperty="Opacity" To="0.32" Duration="0:0:0.16"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="focusGlow" Storyboard.TargetProperty="BlurRadius" To="0" Duration="0:0:0.18"/>
                                                <DoubleAnimation Storyboard.TargetName="focusGlow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── EDITOR DE NOTA ──
                 A caixa de texto formatado das notas. Mesma casca do InputStyle (o mesmo fundo,
                 a mesma borda, o mesmo brilho no foco), porque para quem olha é o mesmo campo;
                 o que muda é o conteúdo, que aqui é documento e não linha de texto.

                 O ScrollViewer do template chama-se PART_ContentHost também no RichTextBox: é o
                 nome que o controle procura para saber onde pôr o documento. -->
            <Style x:Key="EditorDeNota" TargetType="RichTextBox">
                <Setter Property="Padding"          Value="14,10"/>
                <Setter Property="Background"       Value="{DynamicResource InputBgBrush}"/>
                <Setter Property="Foreground"       Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"      Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="BorderThickness"  Value="1"/>
                <Setter Property="FontSize"         Value="13"/>
                <Setter Property="CaretBrush"       Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionBrush"   Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionOpacity" Value="0.28"/>
                <Setter Property="AcceptsTab"       Value="True"/>
                <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RichTextBox">
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource RadiusMd}" SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                              HorizontalScrollBarVisibility="Hidden"
                                              VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush"
                                            Value="{DynamicResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsFocused" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush"
                                            Value="{DynamicResource InputFocusBorderBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A mesma caixa, sem casca: é a da nota flutuante, onde o campo ocupa a janela
                 inteira e quem desenha o limite é a borda dela. -->
            <Style x:Key="EditorDeNotaSemMoldura" TargetType="RichTextBox" BasedOn="{StaticResource EditorDeNota}">
                <Setter Property="Background"      Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding"         Value="0"/>
                <Setter Property="AcceptsTab"      Value="False"/>
            </Style>

            <!-- ── COMBOBOX ── -->
            <Style TargetType="ComboBox">
                <Setter Property="Background"    Value="{DynamicResource InputBgBrush}"/>
                <Setter Property="Foreground"    Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="BorderBrush"   Value="{DynamicResource InputBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize"      Value="13"/>
                <Setter Property="Padding"       Value="12,0"/>
                <Setter Property="Cursor"        Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="{StaticResource RadiusMd}" SnapsToDevicePixels="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="32"/>
                                        </Grid.ColumnDefinitions>
                                        <ContentPresenter x:Name="ContentSite"
                                                          Content="{TemplateBinding SelectionBoxItem}"
                                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                          Margin="12,0,0,0"
                                                          VerticalAlignment="Center"
                                                          IsHitTestVisible="False"/>
                                        <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   IsHitTestVisible="False"/>
                                        <!--
                                            Este ToggleButton é só a área de clique: ele cobre
                                            as duas colunas, por cima do texto e da seta.

                                            O Template vazio não é enfeite. Sem ele o botão usa
                                            o do Windows, que no hover ignora o Background e
                                            pinta #FFBEE6FD — azul claro OPACO — sobre a
                                            largura toda. Como ele está por cima, o que some
                                            é o texto do campo. O mesmo vale com a lista
                                            aberta (IsChecked) e no clique (IsPressed).

                                            O Background="Transparent" do Border fica: sem ele
                                            não há o que receber o clique.
                                        -->
                                        <ToggleButton Grid.ColumnSpan="2"
                                                      Focusable="False"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                                  RelativeSource={RelativeSource TemplatedParent}}"
                                                      Cursor="Hand">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent"/>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                                <Popup x:Name="Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Fade">
                                    <!-- Margem de 14 em volta para a sombra ter onde cair: sem
                                         ela o Popup recorta o próprio blur. -->
                                    <Border Margin="14,4,14,14">
                                        <Border x:Name="DropDownBorder"
                                                MinWidth="{TemplateBinding ActualWidth}"
                                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                                Background="{DynamicResource PopupBgBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusLg}"
                                                Effect="{DynamicResource ShadowGlass}">
                                            <ScrollViewer SnapsToDevicePixels="True" Padding="6">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush"
                                            Value="{DynamicResource BorderStrongBrush}"/>
                                </Trigger>
                                <Trigger Property="IsDropDownOpen" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush"
                                            Value="{DynamicResource InputFocusBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush"
                                            Value="{DynamicResource InputFocusBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="border" Property="Opacity" Value="0.45"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ComboBoxItem">
                <Setter Property="Foreground"   Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="Background"   Value="Transparent"/>
                <Setter Property="Padding"      Value="11,8"/>
                <Setter Property="FontSize"     Value="13"/>
                <Setter Property="Cursor"       Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="{StaticResource RadiusSm}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsHighlighted" Value="True">
                                    <Setter TargetName="bg" Property="Background"
                                            Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="bg" Property="Background"
                                            Value="{DynamicResource AccentLightBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ── CHECKBOX ──
                 A caixa do Windows não combina com nada aqui: quadrado duro, azul de sistema,
                 e no tema escuro um retângulo branco. Esta é a mesma caixa em vidro, com o
                 verde entrando só quando está marcada — que é a única hora em que ela carrega
                 informação. -->
            <Style TargetType="CheckBox">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" Background="Transparent">
                                <Border x:Name="box" Width="19" Height="19" CornerRadius="6"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource BorderStrongBrush}"
                                        BorderThickness="1" VerticalAlignment="Center"
                                        SnapsToDevicePixels="True">
                                    <TextBlock x:Name="check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="10.5" Opacity="0"
                                               Foreground="{DynamicResource AccentForegroundBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ContentPresenter x:Name="rotulo" Margin="9,0,0,0" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <!-- Sem conteúdo (o caso das Configurações e das listas de
                                     tarefa) o rótulo some em vez de deixar um vão de 9px. -->
                                <Trigger Property="Content" Value="{x:Null}">
                                    <Setter TargetName="rotulo" Property="Margin" Value="0"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="check" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38"/>
                                    <Setter Property="Cursor" Value="Arrow"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- ══════════════ SUPERFÍCIES ══════════════ -->

            <!-- CARD — a superfície de repouso. Sem sombra: dez cards com sombra viram borrão.
                 A profundidade vem do filme de vidro e da borda de 1px. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- CARD ESTÁTICO — mesmo desenho, sem reação ao mouse. Para o que é painel de
                 leitura e não alvo de clique: um card inteiro que "acende" ao passar o mouse
                 promete uma ação que não existe. -->
            <Style x:Key="CardStatic" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
            </Style>

            <!-- PAINEL — o degrau acima do card: vidro elevado, canto maior, sombra difusa.
                 Serve para agrupar seções inteiras. -->
            <Style x:Key="SectionPanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceGlassElevatedBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}"/>
                <Setter Property="Padding" Value="{StaticResource PadPanel}"/>
                <Setter Property="Effect" Value="{DynamicResource ShadowSoft}"/>
            </Style>

            <!-- LINHA DE LISTA clicável — categorias, variáveis, integrações, membros. -->
            <Style x:Key="ListRowCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
                <Setter Property="Padding" Value="18,14"/>
            </Style>

            <!--
                LINHA DE LISTA — o padrão de QUALQUER lista longa do app (macros, tarefas,
                notas, lembretes).

                Em repouso ela não é um cartão: é uma faixa transparente com um fio de 1px
                embaixo. Vinte cartões empilhados, cada um com borda e sombra, viram textura —
                o olho para de distinguir onde uma linha acaba e a outra começa.

                Sob o mouse a linha VIRA cartão: o vidro acende, o canto arredonda e o fio some
                (o vidro já marca a divisão; os dois juntos dobrariam a espessura).

                O canto muda de 0 para 18 no hover de propósito. Um fio de 1px sob um retângulo
                de canto arredondado se enrola nas pontas, e o que se vê é um traço torto.
            -->
            <Style x:Key="ListRow" TargetType="Border">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="CornerRadius" Value="0"/>
                <Setter Property="Padding" Value="16,14"/>
                <Setter Property="SnapsToDevicePixels" Value="True"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ESTADO VAZIO — rebaixado, não elevado: nada ali para clicar. -->
            <Style x:Key="EmptyStatePanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}"/>
                <Setter Property="Padding" Value="40"/>
                <Setter Property="UseLayoutRounding" Value="True"/>
            </Style>

            <!-- REBAIXO — a prévia, o bloco de código, o campo de leitura. -->
            <Style x:Key="InsetPanel" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceInsetBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
                <Setter Property="Padding" Value="14,12"/>
            </Style>

            <!-- TILE DE ÍCONE — monocromático por padrão. Uma tela que precise de cor no tile
                 sobrescreve o Background, mas o padrão do sistema é vidro. -->
            <Style x:Key="IconTile" TargetType="Border">
                <Setter Property="Width" Value="42"/>
                <Setter Property="Height" Value="42"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
                <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
            <Style x:Key="IconTileSmall" TargetType="Border" BasedOn="{StaticResource IconTile}">
                <Setter Property="Width" Value="32"/>
                <Setter Property="Height" Value="32"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
            </Style>

            <!-- REFLEXO DE QUINA — 1px no topo de um painel de vidro. Vai dentro de um Grid,
                 por cima do conteúdo, com VerticalAlignment="Top". -->
            <Style x:Key="GlassEdge" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
                <Setter Property="Background" Value="{DynamicResource GlassEdgeBrush}"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Margin" Value="18,0"/>
            </Style>

            <!-- SEPARADOR — a régua de 1px entre linhas de uma lista. Substitui o card por
                 linha: quando cada item vira caixa, a lista inteira vira ruído. -->
            <Style x:Key="RowSeparator" TargetType="Border">
                <Setter Property="Height" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
            </Style>

            <!-- ══════════════ TIPOGRAFIA ══════════════ -->
            <Style x:Key="PageTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
                <Setter Property="FontSize" Value="26"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
            <Style x:Key="PageSubtitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource TextBase}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
            <Style x:Key="SectionTitleText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Style>
            <!-- Rótulo de seção: maiúsculas pequenas, cinza. Organiza sem desenhar caixa. -->
            <Style x:Key="EyebrowText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="9.5"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </Style>
            <Style x:Key="MetaText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{StaticResource TextSm}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            </Style>

            <!-- ══════════════ PEQUENOS ══════════════ -->

            <!-- ETIQUETA — monocromática. Ela é metadado, não título: quando a etiqueta de
                 atalho tem a mesma força visual do nome da macro, a lista perde a hierarquia.
                 Quem precisar de cor (prioridade alta, cancelado) sobrescreve o Background.

                 A forma é retângulo de canto arredondado, o mesmo de todo o resto do app.
                 Era cápsula deitada, e uma cápsula de texto no meio de uma tela de retângulos
                 se anuncia pela forma antes de ser lida. -->
            <Style x:Key="Badge" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource BadgeBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
                <Setter Property="Padding" Value="10,3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="BadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10.5"/>
                <Setter Property="FontWeight" Value="Medium"/>
                <Setter Property="Foreground" Value="{DynamicResource BadgeTextBrush}"/>
            </Style>

            <!-- ETIQUETA DE ATALHO — o "/atalho" de uma macro. Monoespaçada e discreta de
                 propósito. -->
            <!--
                A ETIQUETA DE ATALHO é o único metadado colorido da lista, e por um motivo:
                ela não descreve a macro, ela É o que se digita para chamá-la. Quem procura
                "aquela de homologação" lê o título; quem já sabe qual é procura o atalho.

                Herda de Badge: mesma forma e mesmo tamanho das outras etiquetas, só a cor
                muda. O que a destaca é o accent, não o contorno.
            -->
            <Style x:Key="AtalhoBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentLightBrush}"/>
                <Setter Property="Padding" Value="9,3"/>
            </Style>
            <Style x:Key="AtalhoBadgeText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            </Style>

            <!--
                CHIP DE FILTRO — "Abertas / Hoje / Atrasadas / Concluídas" nas Tarefas e o
                grupo equivalente nos Lembretes.

                Estava definido duas vezes, palavra por palavra, em TarefasView e em
                CompromissosView. Agora é um só, aqui, e as duas telas herdam.

                A altura fixa em 34 mantém o grupo alinhado: com a altura vinda do padding,
                cada chip ficava de um tamanho conforme o texto e a fonte. Em repouso não tem
                preenchimento nenhum — o contorno já separa. O preenchido é o ligado, e é o
                único do grupo que fica assim, senão nenhum se destaca.

                O raio é o de item de lista (10), não o de cápsula: um botão de filtro é um
                botão, e os botões deste app são retângulos arredondados.
            -->
            <Style x:Key="ChipFiltro" TargetType="Button">
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Height" Value="34"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="{StaticResource RadiusSm}"
                                    Padding="17,0"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background"
                                            Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                    <Setter TargetName="bg" Property="BorderBrush"
                                            Value="{DynamicResource BorderStrongBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Botão de opção dentro dos formulários (prioridade, atalho de data). Mesmo
                 chip, um tiquinho menor.

                 A margem tem folga EMBAIXO porque estes botões vivem em linha que quebra: um
                 formulário estreito joga o último para a linha de baixo, e sem os 6px as duas
                 ficam coladas. Era só para isso que a tela de Lembretes mantinha uma cópia
                 deste estilo. -->
            <Style x:Key="BotaoOpcao" TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                <Setter Property="Height" Value="32"/>
                <Setter Property="Margin" Value="0,0,6,6"/>
            </Style>

            <!-- ── TOAST (aviso temporário das telas: verde no sucesso, vermelho no erro) ──
                 Estes dois estilos existem porque quatro das cinco telas pintavam o aviso
                 sempre de verde — um erro de validação aparecia com a cara de confirmação.
                 Toda tela que herda de ViewModelComMensagem usa este par. -->
            <Style x:Key="ToastBorder" TargetType="Border">
                <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
                <Setter Property="Padding" Value="15,11"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MensagemSucesso}" Value="False">
                        <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="ToastTexto" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MensagemSucesso}" Value="False">
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- ── KBD (atalho de teclado) ──
                 Tem de ser lido quando procurado e ignorado quando não. Por isso cinza, e não
                 verde: um rodapé de atalhos em accent compete com o conteúdo da janela. -->
            <Style x:Key="KbdChip" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
                <Setter Property="Padding" Value="7,3"/>
                <Setter Property="HorizontalAlignment" Value="Left"/>
            </Style>
            <Style x:Key="KbdChipText" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
                <Setter Property="FontSize" Value="10"/>
                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            </Style>

            <!-- ── SCROLLBAR ──
                 4px em repouso, 8px sob o mouse. Some quando não está sendo usada, que é o
                 comportamento que se espera de uma barra em 2026. -->
            <Style TargetType="ScrollBar">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Width" Value="10"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="True"
                                       Orientation="{TemplateBinding Orientation}">
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border x:Name="t" Background="{DynamicResource ScrollBarBrush}"
                                                            CornerRadius="3" Margin="6,2" Opacity="0.45"/>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="t" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="t" Property="Margin" Value="4,2"/>
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="t" Property="Opacity" Value="1"/>
                                                            <Setter TargetName="t" Property="Margin" Value="4,2"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Horizontal: a barra deita, e quem manda no tamanho passa a ser a
                         altura. Sem isto, uma barra horizontal fica com 10px de largura e
                         nenhuma altura. -->
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto"/>
                        <Setter Property="Height" Value="10"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- ── TOOLTIP ── vidro, para não sobrar um retângulo amarelo do Windows. -->
            <Style TargetType="ToolTip">
                <Setter Property="Background" Value="{DynamicResource PopupBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize" Value="11.5"/>
                <Setter Property="Padding" Value="11,7"/>
                <Setter Property="HasDropShadow" Value="False"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusSm}"
                                    Padding="{TemplateBinding Padding}"
                                    Margin="0,0,10,10"
                                    MaxWidth="320"
                                    Effect="{DynamicResource ShadowSoft}">
                                <ContentPresenter/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <!-- ── CALENDÁRIO (popup do campo de data) ──
                 O Calendar do WPF vem com a cara do Windows: fundo branco, dias em cinza-escuro
                 e cabeçalho azul. Dentro do tema escuro isso vira um retângulo claro gritando no
                 meio da tela, então os quatro templates são refeitos aqui com as mesmas escovas
                 do resto do app — e, sendo estilos implícitos, valem para qualquer calendário
                 que venha a existir em outra tela. -->
            <Style x:Key="CalendarioDia" TargetType="CalendarDayButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize"   Value="12"/>
                <Setter Property="MinWidth"   Value="32"/>
                <Setter Property="MinHeight"  Value="30"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarDayButton">
                            <Border x:Name="fundo" Background="Transparent"
                                    CornerRadius="{StaticResource RadiusSm}" Margin="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <!-- A ordem importa: o dia escolhido tem de vencer o "é de outro mês"
                                     e o "é hoje", que só pintam o texto. -->
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsToday" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="fundo" Property="Background"
                                            Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="fundo" Property="Background"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Os botões de mês e de ano, que aparecem ao clicar no título do calendário -->
            <Style x:Key="CalendarioMes" TargetType="CalendarButton">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize"   Value="12"/>
                <Setter Property="MinWidth"   Value="56"/>
                <!-- Doze meses em três linhas ocupando a mesma altura que as seis semanas da
                     grade de dias: a troca de modo não muda o tamanho do popup nem deixa um
                     vazio embaixo. -->
                <Setter Property="MinHeight"  Value="66"/>
                <Setter Property="Cursor"     Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarButton">
                            <Border x:Name="fundo" Background="Transparent"
                                    CornerRadius="{StaticResource RadiusSm}" Margin="6,12">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsInactive" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="fundo" Property="Background"
                                            Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                </Trigger>
                                <!-- O mês (ou ano) que contém o dia escolhido — CalendarButton não tem
                                     IsSelected, quem marca é HasSelectedDays. -->
                                <Trigger Property="HasSelectedDays" Value="True">
                                    <Setter TargetName="fundo" Property="Background"
                                            Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CalendarioItem" TargetType="CalendarItem">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CalendarItem">
                            <ControlTemplate.Resources>
                                <!-- Dom, Seg, Ter... quem escreve os nomes é o próprio CalendarItem,
                                     a partir da cultura; aqui só se diz como eles aparecem. -->
                                <DataTemplate x:Key="{x:Static prim:CalendarItem.DayTitleTemplateResourceKey}">
                                    <TextBlock Text="{Binding}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,4,0,6"/>
                                </DataTemplate>
                            </ControlTemplate.Resources>
                            <Grid x:Name="PART_Root" Margin="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid Margin="2,0,2,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="PART_PreviousButton" Grid.Column="0"
                                            Style="{StaticResource ButtonIconOnly}" Width="28" Height="28">
                                        <TextBlock Text="&#xE76B;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button x:Name="PART_HeaderButton" Grid.Column="1"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource TextPrimaryBrush}"
                                            FontSize="13" FontWeight="SemiBold" FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="fundo" Background="Transparent"
                                                        CornerRadius="{StaticResource RadiusSm}" Padding="10,5">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="fundo" Property="Background"
                                                                Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <Button x:Name="PART_NextButton" Grid.Column="2"
                                            Style="{StaticResource ButtonIconOnly}" Width="28" Height="28">
                                        <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                </Grid>

                                <!-- As duas grades vêm vazias de propósito: o CalendarItem cria os
                                     botões dentro delas, e só precisa das linhas e colunas prontas. -->
                                <Grid x:Name="PART_MonthView" Grid.Row="1" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                </Grid>

                                <Grid x:Name="PART_YearView" Grid.Row="1" HorizontalAlignment="Center"
                                      Visibility="Hidden">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                </Grid>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <!-- Modo mês mostra os dias; mês e ano trocam para a grade de 4x3. -->
                                <DataTrigger Binding="{Binding DisplayMode,
                                                       RelativeSource={RelativeSource AncestorType=Calendar}}"
                                             Value="Year">
                                    <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                    <Setter TargetName="PART_YearView"  Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DisplayMode,
                                                       RelativeSource={RelativeSource AncestorType=Calendar}}"
                                             Value="Decade">
                                    <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
                                    <Setter TargetName="PART_YearView"  Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="Calendar">
                <Setter Property="Background"  Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
                <Setter Property="FontSize"    Value="12"/>
                <!-- Os três estilos entram por aqui, e não como estilo implícito: quem cria os
                     botões de dia e de mês é o CalendarItem, em código, e ele só aplica o que
                     estiver nestas propriedades. Sem isto, os dias saem com o estilo de fábrica
                     — texto cinza-escuro invisível no tema escuro, e o dia escolhido sem marca. -->
                <Setter Property="CalendarDayButtonStyle" Value="{StaticResource CalendarioDia}"/>
                <Setter Property="CalendarButtonStyle"    Value="{StaticResource CalendarioMes}"/>
                <Setter Property="CalendarItemStyle"      Value="{StaticResource CalendarioItem}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Calendar">
                            <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                                <CalendarItem x:Name="PART_CalendarItem"
                                              Style="{TemplateBinding CalendarItemStyle}"
                                              Background="{TemplateBinding Background}"
                                              BorderThickness="0"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
