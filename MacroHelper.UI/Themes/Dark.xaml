<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ══════════════════════════════════════════════════════════════════════════════
        DARK — "Obsidian Glass"
        ══════════════════════════════════════════════════════════════════════════════

        Grafite azulado quase preto, cinzas frios, texto off-white. O verde é IDENTIDADE,
        não revestimento: aparece na ação principal, no item ativo, no foco e num punhado de
        indicadores. Fora disso a tela é acromática de propósito — o que colore é o dado,
        não a decoração.

        Níveis de superfície (a hierarquia inteira do app cabe em quatro):

            Surface0  — o fundo da janela: gradiente profundo + duas luzes ambiente.
            Surface1  — painel opaco, para onde a legibilidade não pode depender do que
                        está atrás (popups, dropdowns).
            Glass     — o filme translúcido: cards, painéis, barra lateral.
            Elevated  — vidro mais claro: herói, janela flutuante, item selecionado.

        O filme de vidro é um gradiente vertical de branco com alfa muito baixo — mais claro
        em cima, como luz raspando a quina — e não um valor chapado. É o que faz dois painéis
        vizinhos continuarem se distinguindo quando ficam lado a lado.
    -->

    <!-- ═══ CORES BASE ═══════════════════════════════════════════════════════════ -->
    <Color x:Key="BackdropDeepColor">#04060A</Color>
    <Color x:Key="BackgroundColor">#080B10</Color>
    <Color x:Key="SurfaceColor">#101419</Color>
    <Color x:Key="SurfaceElevatedColor">#161B22</Color>
    <Color x:Key="BorderColor">#2A323A</Color>
    <Color x:Key="BorderLightColor">#1C222A</Color>
    <Color x:Key="TextPrimaryColor">#ECEFF2</Color>
    <Color x:Key="TextSecondaryColor">#98A2AC</Color>
    <Color x:Key="TextMutedColor">#646E78</Color>

    <!-- ═══ ACCENT — o verde do SK ═══════════════════════════════════════════════
         Um único verde em quatro papéis: preenchimento, hover, tinta de texto e tinte de
         fundo. O AccentForeground é o que se escreve EM CIMA do verde — quase preto, porque
         este verde é claro. O ThemeService recalcula os quatro quando o usuário escolhe
         outra cor de destaque nas Configurações. -->
    <Color x:Key="AccentColor">#9BC653</Color>
    <Color x:Key="AccentHoverColor">#87B23F</Color>
    <Color x:Key="AccentTextColor">#9BC653</Color>
    <Color x:Key="AccentLightColor">#1E9BC653</Color>
    <Color x:Key="AccentSoftColor">#129BC653</Color>
    <Color x:Key="AccentGlowColor">#599BC653</Color>
    <Color x:Key="AccentForegroundColor">#0A0F04</Color>
    <Color x:Key="AccentDeepColor">#2C4520</Color>

    <!-- Tons de apoio. Existem para os poucos lugares que pedem um segundo timbre (tiles
         decorativos, gradientes) e ficam dessaturados de propósito. -->
    <Color x:Key="SecondaryColor">#39414D</Color>
    <Color x:Key="SecondaryForegroundColor">#C2CBD5</Color>
    <Color x:Key="CyanColor">#6DAFA4</Color>
    <Color x:Key="CyanSoftColor">#14FFFFFF</Color>
    <Color x:Key="CyanForegroundColor">#A6B3BD</Color>

    <!-- Semânticas: entram só quando a cor É o significado (sucesso, erro, prazo). -->
    <Color x:Key="SuccessColor">#5FCB8E</Color>
    <Color x:Key="SuccessBgColor">#1B2A23</Color>
    <Color x:Key="DangerColor">#F07B67</Color>
    <Color x:Key="DangerBgColor">#2B1917</Color>
    <Color x:Key="WarningColor">#E8B85F</Color>
    <Color x:Key="WarningBgColor">#2B2418</Color>

    <!-- Barra lateral: vidro sobre o mesmo fundo, sem cor própria. -->
    <Color x:Key="SidebarColor">#0A0E13</Color>
    <Color x:Key="SidebarItemHoverColor">#10FFFFFF</Color>
    <Color x:Key="SidebarItemActiveColor">#1AFFFFFF</Color>
    <Color x:Key="SidebarTextColor">#98A2AC</Color>
    <Color x:Key="SidebarTextActiveColor">#ECEFF2</Color>
    <Color x:Key="SidebarMutedColor">#5A646E</Color>
    <Color x:Key="SidebarAccentColor">#A7C957</Color>
    <Color x:Key="SidebarBorderColor">#14FFFFFF</Color>

    <!-- Campos: fundo rebaixado — o inverso do vidro, escurece em vez de clarear. -->
    <Color x:Key="InputBgColor">#26000000</Color>
    <Color x:Key="InputBorderColor">#1FFFFFFF</Color>
    <Color x:Key="InputFocusBorderColor">#9BC653</Color>

    <Color x:Key="TableHeaderBgColor">#0AFFFFFF</Color>
    <Color x:Key="TableRowHoverColor">#0DFFFFFF</Color>
    <Color x:Key="TableRowAltColor">#06FFFFFF</Color>
    <Color x:Key="ScrollBarColor">#33FFFFFF</Color>

    <!-- Popup é opaco de propósito: não há blur por trás dele, e texto sobre texto não se lê. -->
    <Color x:Key="PopupBgColor">#12171D</Color>
    <Color x:Key="PopupBorderColor">#2A323A</Color>

    <!-- Pílula monocromática. Verde só quando a pílula significar alguma coisa. -->
    <Color x:Key="BadgeBgColor">#14FFFFFF</Color>
    <Color x:Key="BadgeTextColor">#A2ACB6</Color>

    <Color x:Key="ShadowColor">#A6000000</Color>
    <Color x:Key="TitleBarBgColor">#00000000</Color>

    <!-- Vidro: os alfas do filme branco, nomeados por papel e não por valor. -->
    <Color x:Key="GlassFilmTopColor">#0FFFFFFF</Color>
    <Color x:Key="GlassFilmBottomColor">#07FFFFFF</Color>
    <Color x:Key="GlassHoverTopColor">#17FFFFFF</Color>
    <Color x:Key="GlassHoverBottomColor">#0DFFFFFF</Color>
    <Color x:Key="GlassActiveTopColor">#24FFFFFF</Color>
    <Color x:Key="GlassActiveBottomColor">#16FFFFFF</Color>
    <Color x:Key="GlassElevatedTopColor">#1CFFFFFF</Color>
    <Color x:Key="GlassElevatedBottomColor">#0BFFFFFF</Color>
    <Color x:Key="BorderSubtleColor">#16FFFFFF</Color>
    <Color x:Key="BorderStrongColor">#2BFFFFFF</Color>
    <Color x:Key="GlassEdgeColor">#40FFFFFF</Color>

    <!-- ═══ BRUSHES ══════════════════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="BackgroundBrush"           Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="BackdropDeepBrush"         Color="{StaticResource BackdropDeepColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush"              Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="SurfaceElevatedBrush"      Color="{StaticResource SurfaceElevatedColor}"/>
    <SolidColorBrush x:Key="BorderBrush"               Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderLightBrush"          Color="{StaticResource BorderLightColor}"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"          Color="{StaticResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"        Color="{StaticResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="TextMutedBrush"            Color="{StaticResource TextMutedColor}"/>
    <SolidColorBrush x:Key="AccentBrush"               Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush"          Color="{StaticResource AccentHoverColor}"/>
    <SolidColorBrush x:Key="AccentLightBrush"          Color="{StaticResource AccentLightColor}"/>
    <SolidColorBrush x:Key="AccentSoftBrush"           Color="{StaticResource AccentSoftColor}"/>
    <SolidColorBrush x:Key="AccentGlowBrush"           Color="{StaticResource AccentGlowColor}"/>
    <SolidColorBrush x:Key="AccentTextBrush"           Color="{StaticResource AccentTextColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush"     Color="{StaticResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="SecondaryBrush"            Color="{StaticResource SecondaryColor}"/>
    <SolidColorBrush x:Key="SecondaryForegroundBrush"  Color="{StaticResource SecondaryForegroundColor}"/>
    <SolidColorBrush x:Key="CyanBrush"                 Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="CyanSoftBrush"             Color="{StaticResource CyanSoftColor}"/>
    <SolidColorBrush x:Key="CyanForegroundBrush"       Color="{StaticResource CyanForegroundColor}"/>
    <SolidColorBrush x:Key="SuccessBrush"              Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="SuccessBgBrush"            Color="{StaticResource SuccessBgColor}"/>
    <SolidColorBrush x:Key="DangerBrush"               Color="{StaticResource DangerColor}"/>
    <SolidColorBrush x:Key="DangerBgBrush"             Color="{StaticResource DangerBgColor}"/>
    <SolidColorBrush x:Key="WarningBrush"              Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="WarningBgBrush"            Color="{StaticResource WarningBgColor}"/>
    <SolidColorBrush x:Key="SidebarBrush"              Color="{StaticResource SidebarColor}"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush"     Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveBrush"    Color="{StaticResource SidebarItemActiveColor}"/>
    <SolidColorBrush x:Key="SidebarTextBrush"          Color="{StaticResource SidebarTextColor}"/>
    <SolidColorBrush x:Key="SidebarTextActiveBrush"    Color="{StaticResource SidebarTextActiveColor}"/>
    <SolidColorBrush x:Key="SidebarMutedBrush"         Color="{StaticResource SidebarMutedColor}"/>
    <SolidColorBrush x:Key="SidebarAccentBrush"        Color="{StaticResource SidebarAccentColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"        Color="{StaticResource SidebarBorderColor}"/>
    <SolidColorBrush x:Key="InputBgBrush"              Color="{StaticResource InputBgColor}"/>
    <SolidColorBrush x:Key="InputBorderBrush"          Color="{StaticResource InputBorderColor}"/>
    <SolidColorBrush x:Key="InputFocusBorderBrush"     Color="{StaticResource InputFocusBorderColor}"/>
    <SolidColorBrush x:Key="TableHeaderBgBrush"        Color="{StaticResource TableHeaderBgColor}"/>
    <SolidColorBrush x:Key="TableRowHoverBrush"        Color="{StaticResource TableRowHoverColor}"/>
    <SolidColorBrush x:Key="TableRowAltBrush"          Color="{StaticResource TableRowAltColor}"/>
    <SolidColorBrush x:Key="ScrollBarBrush"            Color="{StaticResource ScrollBarColor}"/>
    <SolidColorBrush x:Key="PopupBgBrush"              Color="{StaticResource PopupBgColor}"/>
    <SolidColorBrush x:Key="PopupBorderBrush"          Color="{StaticResource PopupBorderColor}"/>
    <SolidColorBrush x:Key="BadgeBgBrush"              Color="{StaticResource BadgeBgColor}"/>
    <SolidColorBrush x:Key="BadgeTextBrush"            Color="{StaticResource BadgeTextColor}"/>
    <SolidColorBrush x:Key="TitleBarBgBrush"           Color="{StaticResource TitleBarBgColor}"/>

    <!-- ═══ SUPERFÍCIES DE VIDRO ═════════════════════════════════════════════════ -->
    <SolidColorBrush x:Key="Surface0Brush" Color="{StaticResource BackgroundColor}"/>
    <SolidColorBrush x:Key="Surface1Brush" Color="{StaticResource SurfaceColor}"/>

    <LinearGradientBrush x:Key="SurfaceGlassBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GlassFilmTopColor}"    Offset="0"/>
        <GradientStop Color="{StaticResource GlassFilmBottomColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceGlassHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GlassHoverTopColor}"    Offset="0"/>
        <GradientStop Color="{StaticResource GlassHoverBottomColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceGlassActiveBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GlassActiveTopColor}"    Offset="0"/>
        <GradientStop Color="{StaticResource GlassActiveBottomColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SurfaceGlassElevatedBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource GlassElevatedTopColor}"    Offset="0"/>
        <GradientStop Color="{StaticResource GlassElevatedBottomColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Rebaixo: o inverso do vidro. Vale onde o conteúdo é "de dentro" — a prévia de um
         texto, um campo. -->
    <LinearGradientBrush x:Key="SurfaceInsetBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#30000000" Offset="0"/>
        <GradientStop Color="#1C000000" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="BorderSubtleBrush" Color="{StaticResource BorderSubtleColor}"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="{StaticResource BorderStrongColor}"/>

    <!-- Reflexo de quina: 1px no topo do painel, apagando nas pontas. É o detalhe que faz o
         vidro parecer vidro em vez de um retângulo translúcido. -->
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0"/>
        <GradientStop Color="{StaticResource GlassEdgeColor}" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══ FUNDO AMBIENTE ═══════════════════════════════════════════════════════
         O chão sobre o qual todo o vidro é composto: um gradiente diagonal profundo e duas
         luzes fracas — uma verde (a identidade) e uma fria. São radiais com parada
         transparente, e não BlurEffect: mesmo desenho, sem custo por quadro. -->
    <LinearGradientBrush x:Key="AmbientBackdropBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0A0F15" Offset="0"/>
        <GradientStop Color="#070A0F" Offset="0.55"/>
        <GradientStop Color="#04060A" Offset="1"/>
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="AmbientGlowAccentBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#1FA7C957" Offset="0"/>
        <GradientStop Color="#0AA7C957" Offset="0.45"/>
        <GradientStop Color="#00A7C957" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="AmbientGlowCoolBrush" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#2A5B7FD9" Offset="0"/>
        <GradientStop Color="#0E4A6FC8" Offset="0.45"/>
        <GradientStop Color="#003A5FB0" Offset="1"/>
    </RadialGradientBrush>

    <!-- Gradiente de marca: os poucos tiles que carregam o logo. Do verde escuro ao verde da
         identidade — glifo branco continua legível nas duas pontas. -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource AccentDeepColor}" Offset="0"/>
        <GradientStop Color="#5E8A34" Offset="1"/>
    </LinearGradientBrush>

    <!-- ═══ JANELA FLUTUANTE ═══════════════════════════════════════════════════════
         A busca rápida abre sobre o Windows inteiro, sem blur de sistema por baixo. Por isso
         o fundo dela é quase opaco: o desktop aparece só como uma insinuação nas bordas, e o
         texto continua legível sobre qualquer papel de parede. -->
    <!--
        LUZES DE CANTO

        Vão pintadas como FUNDO de um Border que tem raio — e é isso que faz a luz acompanhar
        a curva do painel. A versão anterior usava manchas maiores que o painel, cortadas pelo
        ClipToBounds: o corte é retangular, então aparecia uma quina reta bem em cima do canto
        arredondado.

        As coordenadas são relativas à caixa (RelativeToBoundingBox), então o mesmo pincel
        serve para a casca da janela e para o herói, cada um com o seu tamanho.
    -->
    <RadialGradientBrush x:Key="GlowCornerTopLeftBrush"
                         Center="0.02,-0.04" GradientOrigin="0.02,-0.04" RadiusX="0.50" RadiusY="0.92">
        <GradientStop Color="#1CA7C957" Offset="0"/>
        <GradientStop Color="#0AA7C957" Offset="0.45"/>
        <GradientStop Color="#00A7C957" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowCornerTopRightBrush"
                         Center="0.88,-0.14" GradientOrigin="0.88,-0.14" RadiusX="0.42" RadiusY="1.15">
        <GradientStop Color="#20A7C957" Offset="0"/>
        <GradientStop Color="#0BA7C957" Offset="0.45"/>
        <GradientStop Color="#00A7C957" Offset="1"/>
    </RadialGradientBrush>
    <RadialGradientBrush x:Key="GlowCornerBottomRightBrush"
                         Center="1.02,1.06" GradientOrigin="1.02,1.06" RadiusX="0.46" RadiusY="0.88">
        <GradientStop Color="#265B7FD9" Offset="0"/>
        <GradientStop Color="#0C4A6FC8" Offset="0.45"/>
        <GradientStop Color="#003A5FB0" Offset="1"/>
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="FloatSurfaceBrush" StartPoint="0,0" EndPoint="0.35,1">
        <GradientStop Color="#F71A2028" Offset="0"/>
        <GradientStop Color="#F5121821" Offset="0.45"/>
        <GradientStop Color="#F40B0F15" Offset="1"/>
    </LinearGradientBrush>
    <!-- A borda de tudo que flutua: janela solta, popup e modal. Ela é a única separação
         entre o cartão e o que estiver atrás — nenhuma dessas superfícies tem sombra, nem a
         do WPF nem a do sistema — e por isso é mais forte que a borda de um card comum. -->
    <SolidColorBrush x:Key="FloatBorderBrush" Color="#40FFFFFF"/>

    <!-- ═══ SOMBRAS ══════════════════════════════════════════════════════════════
         Aqui o preto pode ser preto: sobre um fundo escuro ele não desenha faixa cinza,
         só afunda o que está atrás. RenderingBias="Quality" pelo mesmo motivo do claro —
         o borrão de baixa resolução deixa bico nas quinas arredondadas. -->
    <DropShadowEffect x:Key="ShadowSoft"  Color="#000000" BlurRadius="24" ShadowDepth="4"  Opacity="0.20" Direction="270" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="ShadowGlass" Color="#000000" BlurRadius="40" ShadowDepth="10" Opacity="0.28" Direction="270" RenderingBias="Quality"/>
    <DropShadowEffect x:Key="ShadowFloat" Color="#000000" BlurRadius="64" ShadowDepth="18" Opacity="0.42" Direction="270" RenderingBias="Quality"/>

</ResourceDictionary>
