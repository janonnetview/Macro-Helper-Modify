<Window x:Class="MacroHelper.UI.Views.TarefaFlutuanteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MacroHelper.UI.Controls"
        xmlns:h="clr-namespace:MacroHelper.UI.Helpers"
        Width="470" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- Mesmos botões da janela de nota, e pela mesma razão: o ButtonPrimary do App.xaml
             carrega um DropShadowEffect permanente, e qualquer Effect desliga o ClearType do
             texto dentro dele — num botão pequeno isso aparece como borrão. -->
        <Style x:Key="BotaoTarefa" TargetType="Button">
            <Setter Property="FontSize"         Value="11.5"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Padding"          Value="16,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoTarefaPrimario" TargetType="Button" BasedOn="{StaticResource BotaoTarefa}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Padding"    Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip de prioridade: o ativo acende. O Tag guarda a prioridade que ele representa. -->
        <Style x:Key="ChipPrioridade" TargetType="RadioButton">
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Focusable"        Value="False"/>
            <Setter Property="FontSize"         Value="11"/>
            <Setter Property="Margin"           Value="0,0,6,0"/>
            <Setter Property="Foreground"       Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg" CornerRadius="8" Padding="13,5" SnapsToDevicePixels="True"
                                Background="Transparent" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderSubtleBrush}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RotuloCampo" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="9.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Margin"     Value="0,0,0,5"/>
        </Style>

        <!-- Botão de adiar: menor que o do rodapé, e do tamanho do chip de prioridade ao lado.
             São três atalhos para o campo de lembrete logo acima, não ações de janela. -->
        <Style x:Key="ChipAdiar" TargetType="Button" BasedOn="{StaticResource BotaoTarefa}">
            <Setter Property="Height"   Value="26"/>
            <Setter Property="Padding"  Value="12,0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin"   Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <!-- Sem sombra, aqui e nas outras flutuantes: quem separa a janela do que está atrás é a
         borda do cartão. A sombra do sistema sai no MolduraNativa, chamado no construtor. -->
    <Border CornerRadius="{StaticResource RadiusWindow}"
            Background="{DynamicResource FloatSurfaceBrush}"
            BorderBrush="{DynamicResource FloatBorderBrush}" BorderThickness="1">
        <StackPanel>

            <!-- Também é a alça de arraste: clique no checkbox, no título e no fechar continuam
                 funcionando normal, porque marcam o evento como tratado antes de chegar aqui. -->
            <Border Padding="18,13,12,11" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Concluir daqui também: quem abriu a tarefa para mexer nela muitas vezes
                         só queria riscá-la. -->
                    <Button x:Name="BtnConcluir" Grid.Column="0" Click="BtnConcluir_Click"
                            Width="20" Height="20" Margin="0,0,11,0" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="Concluir / reabrir">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="caixa" Width="18" Height="18" CornerRadius="8"
                                        BorderThickness="1.5" SnapsToDevicePixels="True"
                                        Background="Transparent"
                                        BorderBrush="{DynamicResource BorderStrongBrush}">
                                    <TextBlock x:Name="tique" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="9" Foreground="White" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter TargetName="caixa" Property="Background"  Value="{DynamicResource SuccessBrush}"/>
                                        <Setter TargetName="caixa" Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                                        <Setter TargetName="tique" Property="Visibility"  Value="Visible"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBox x:Name="TxtTitulo" Grid.Column="1"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             FontSize="15" FontWeight="SemiBold"
                             VerticalContentAlignment="Center"/>

                    <Button Grid.Column="2" Click="BtnFechar_Click"
                            Width="28" Height="28" Cursor="Hand"
                            Background="Transparent" BorderThickness="0"
                            ToolTip="Fechar (Esc)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="8" SnapsToDevicePixels="True"
                                        Background="{TemplateBinding Background}">
                                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background"
                                                Value="{DynamicResource SurfaceElevatedBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <StackPanel Margin="18,14,18,4">
                <TextBlock Text="OBSERVAÇÕES" Style="{StaticResource RotuloCampo}"/>
                <TextBox x:Name="TxtObservacoes" MinHeight="58" MaxHeight="130" Margin="0,0,0,14"
                         AcceptsReturn="True" AcceptsTab="False" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         FontSize="12.5" VerticalContentAlignment="Top"/>

                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="PRIORIDADE" Style="{StaticResource RotuloCampo}"/>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="RbBaixa"  Content="Baixa"  GroupName="Prioridade"
                                         Style="{StaticResource ChipPrioridade}"/>
                            <RadioButton x:Name="RbNormal" Content="Normal" GroupName="Prioridade"
                                         Style="{StaticResource ChipPrioridade}"/>
                            <RadioButton x:Name="RbAlta"   Content="Alta"   GroupName="Prioridade"
                                         Style="{StaticResource ChipPrioridade}"/>
                        </StackPanel>
                    </StackPanel>

                    <!--
                        O Tag guarda o nome do valor de RecorrenciaTarefa, e o code-behind
                        converte por nome. Por índice seria mais curto e quebraria em silêncio
                        no dia em que alguém reordenasse os itens desta lista.
                    -->
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="REPETIR" Style="{StaticResource RotuloCampo}"/>
                        <ComboBox x:Name="CmbRecorrencia" Height="32" SelectedIndex="0"
                                  ToolTip="Ao concluir, a próxima ocorrência é criada sozinha">
                            <ComboBoxItem Content="Não repete"     Tag="Nenhuma"/>
                            <ComboBoxItem Content="Todo dia"       Tag="Diaria"/>
                            <ComboBoxItem Content="Dias úteis"     Tag="DiasUteis"/>
                            <ComboBoxItem Content="Toda semana"    Tag="Semanal"/>
                            <ComboBoxItem Content="A cada 15 dias" Tag="Quinzenal"/>
                            <ComboBoxItem Content="Todo mês"       Tag="Mensal"/>
                            <ComboBoxItem Content="Todo ano"       Tag="Anual"/>
                        </ComboBox>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,18,0">
                        <TextBlock Text="PRAZO: informativo" Style="{StaticResource RotuloCampo}"/>
                        <c:SeletorDeData x:Name="CampoPrazo"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="LEMBRETE: a notificação" Style="{StaticResource RotuloCampo}"/>
                        <StackPanel Orientation="Horizontal">
                            <c:SeletorDeData x:Name="CampoLembreteData" Margin="0,0,8,0"/>
                            <Grid Width="76" Height="38">
                                <TextBox x:Name="TxtLembreteHora" Style="{StaticResource InputStyle}"
                                         MaxLength="5" h:MascaraTexto.Formato="Hora"/>
                                <TextBlock Text="hh:mm" FontSize="13" IsHitTestVisible="False"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="13,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=TxtLembreteHora}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!--
                    Adiar existe porque o balão da bandeja não aceita botão: o lembrete já foi
                    marcado como disparado antes de aparecer, e sem um caminho de volta um
                    lembrete que chega em hora ruim está perdido. Estes três escrevem no campo
                    de lembrete acima e regravam, então o que acontece aqui é visível ali.
                -->
                <StackPanel x:Name="PainelAdiar" Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="ADIAR PARA" Style="{StaticResource RotuloCampo}"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="15 min"  Click="BtnAdiar15_Click"    Style="{StaticResource ChipAdiar}"/>
                    <Button Content="1 hora"  Click="BtnAdiar1h_Click"    Style="{StaticResource ChipAdiar}"/>
                    <Button Content="Amanhã"  Click="BtnAdiarAmanha_Click" Style="{StaticResource ChipAdiar}"
                            ToolTip="Amanhã às 9h"/>
                </StackPanel>
            </StackPanel>

            <Border Padding="14,10" Margin="0,10,0,0" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderStrongBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Apagar fica longe do Salvar e pede um segundo clique. -->
                    <Button x:Name="BtnApagar" Grid.Column="0" Content="Apagar"
                            Click="BtnApagar_Click" Style="{StaticResource BotaoTarefa}"
                            Padding="12,0" Foreground="{DynamicResource DangerBrush}"/>

                    <c:LinhaDeEstado x:Name="Estado" Grid.Column="1"
                                    Margin="12,0" FontSize="9.5"
                                    VerticalAlignment="Center"/>

                    <Button Grid.Column="2" Content="Salvar" Click="BtnSalvar_Click"
                            Style="{StaticResource BotaoTarefaPrimario}"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
