<UserControl x:Class="MacroHelper.UI.Views.AgendaCalendarioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MacroHelper.UI.Controls"
             Background="Transparent">

    <!--
        As duas grades da tela de Lembretes. O DataContext é o mesmo CompromissosViewModel da
        lista: elas não são outra tela, são a mesma agenda vista de longe.

        O que a grade acrescenta à lista é uma coisa só, e é o motivo dela existir: CHOQUE DE
        HORÁRIO SE VÊ. Dois compromissos que se cruzam ficam lado a lado, cada um com metade da
        largura do dia, com a borda de aviso. Na lista isso era uma frase no toast de quem
        acabou de salvar, e sumia depois.
    -->

    <UserControl.Resources>
        <!-- A etiqueta de um compromisso na célula do mês. Não cabe hora e título em duas
             linhas num quadrado de 90px de altura, então os dois vão na mesma. -->
        <Style x:Key="EtiquetaDoMes" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource RadiusXs}"/>
            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="Padding" Value="5,2"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
    </UserControl.Resources>

    <!--
        A navegação do período (as setas, o título e o "Hoje") NÃO mora aqui: ela fica na mesma
        fileira dos botões Lista/Semana/Mês, em CompromissosView. Eram duas fileiras dizendo
        respeito à mesma coisa, uma embaixo da outra, e a de baixo custava uns 45px de altura
        que a grade queria para si.
    -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ── O que não tem data ──
             A grade não tem onde desenhar quem não tem hora, e escondê-lo seria pior do que
             não ter grade: o lembrete por marcar é justamente o que espera decisão. -->
        <Border Grid.Row="0" Style="{StaticResource InsetPanel}" Padding="12,8" Margin="0,0,0,10"
                Visibility="{Binding TotalSemData, Converter={StaticResource IntToVis}}">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                               Foreground="{DynamicResource WarningBrush}"
                               VerticalAlignment="Center" Margin="0,0,7,0"/>
                    <TextBlock FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <Run Text="Sem data marcada:"/>
                        <Run Text="{Binding TotalSemData, Mode=OneWay}" FontWeight="Bold"/>
                        <Run Text="(fora da grade)"/>
                    </TextBlock>
                </StackPanel>
                <Button Content="Ver na lista" HorizontalAlignment="Right" Height="26" FontSize="11"
                        Style="{StaticResource ChipFiltro}" Margin="0"
                        CommandParameter="lista"
                        Command="{Binding DefinirModoCommand}"/>
            </Grid>
        </Border>

        <!-- ══ SEMANA ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Visibility="{Binding Modo, Converter={StaticResource StringEqualsToVis}, ConverterParameter=semana}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- A régua tem a largura de "08h" e do respiro dela, e não um dedo a mais: os
                 10px que sobravam ali eram 10px que não iam para os sete dias. -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Cabeçalho dos sete dias. A margem da direita é a largura da barra de rolagem
                 de baixo: sem ela as colunas do cabeçalho e as da grade saem desalinhadas. -->
            <ItemsControl Grid.Row="0" Grid.Column="1" Margin="0,0,10,2"
                          ItemsSource="{Binding DiasDaSemana}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Clicar no dia marca alguma coisa nele. É o gesto de agenda. -->
                        <Button Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                                HorizontalContentAlignment="Stretch"
                                ToolTip="Novo lembrete neste dia"
                                CommandParameter="{Binding Data}"
                                Command="{Binding DataContext.NovoNoDiaCommand,
                                          RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="fundo" CornerRadius="{StaticResource RadiusSm}"
                                            Background="Transparent" Padding="0,3" Margin="1,0">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="fundo" Property="Background"
                                                    Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <StackPanel>
                                <TextBlock Text="{Binding DiaDaSemanaTexto}" FontSize="10.5"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <!-- FontSize e Foreground moram no Style: valor local no
                                         elemento venceria o Setter do DataTrigger, e o dia de
                                         hoje sairia igual aos outros. -->
                                    <TextBlock Text="{Binding NumeroTexto}" Margin="0,1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize"   Value="15"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                                        <Setter Property="FontWeight" Value="Bold"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                               VerticalAlignment="Center" Margin="5,2,0,0"
                                               ToolTip="Tem choque de horário neste dia"
                                               Foreground="{DynamicResource WarningBrush}"
                                               Visibility="{Binding TemChoque, Converter={StaticResource BoolToVisConv}}"/>
                                </StackPanel>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- A barra fica sempre visível, e não em Auto: em Auto ela aparece e some conforme
                 a faixa de horas muda, e o cabeçalho acima desalinha junto. -->
            <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                          VerticalScrollBarVisibility="Visible">
                <!-- A folga do topo é da RÉGUA: a etiqueta de cada hora sobe 7px para ficar
                     centrada na linha, e sem ela a primeira ficaria cortada na borda. A margem
                     é do Grid inteiro, e não da régua, para os dois lados descerem juntos. -->
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="42"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Régua das horas -->
                    <ItemsControl Grid.Column="0" ItemsSource="{Binding HorasDaGrade}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="{Binding Altura}">
                                    <TextBlock Text="{Binding Texto}" FontSize="10.5"
                                               HorizontalAlignment="Right" VerticalAlignment="Top"
                                               Margin="0,-7,8,0"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Os sete dias -->
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding DiasDaSemana}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="1,0,0,0" Margin="0,0,0,0"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <!-- O fundo do dia: uma faixa por meia hora, e cada uma
                                             é um botão que marca um lembrete NAQUELE horário.
                                             Sem isto o corpo da grade só servia para olhar, e
                                             marcar exigia voltar ao botão do alto e digitar dia
                                             e hora à mão.

                                             As faixas são do DIA, e não da tela: só elas sabem
                                             que aquele pedaço é 14h30 da quinta. A régua da
                                             esquerda continua lendo HorasDaGrade, com a mesma
                                             altura de hora. -->
                                        <ItemsControl ItemsSource="{Binding Faixas}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Height="{Binding Altura}" Cursor="Hand"
                                                            Focusable="False" FocusVisualStyle="{x:Null}"
                                                            HorizontalContentAlignment="Stretch"
                                                            ToolTip="{Binding Texto}"
                                                            CommandParameter="{Binding Inicio}"
                                                            Command="{Binding DataContext.NovoNoInstanteCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <!-- Background transparente, e não
                                                                     nulo: pixel sem pincel não
                                                                     recebe clique nenhum. -->
                                                                <Border x:Name="faixa" Background="Transparent"/>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding InicioDeHora}" Value="True">
                                                                        <Setter TargetName="faixa" Property="BorderThickness" Value="0,1,0,0"/>
                                                                        <Setter TargetName="faixa" Property="BorderBrush"
                                                                                Value="{DynamicResource BorderSubtleBrush}"/>
                                                                    </DataTrigger>
                                                                    <!-- O realce é a única pista de
                                                                         que a meia hora também é
                                                                         clicável: não há linha
                                                                         desenhada no meio da hora. -->
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="faixa" Property="Background"
                                                                                Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Blocos}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <c:PainelDeAgenda PrimeiraHora="{Binding PrimeiraHora}"
                                                                      UltimaHora="{Binding UltimaHora}"
                                                                      AlturaDaHora="{Binding AlturaDaHora}"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <!-- O painel arruma cada filho pelo bloco dele: a
                                                 hora vira altura, e a coluna vira a fatia da
                                                 largura do dia. -->
                                            <ItemsControl.ItemContainerStyle>
                                                <Style TargetType="ContentPresenter">
                                                    <Setter Property="c:PainelDeAgenda.Bloco" Value="{Binding}"/>
                                                </Style>
                                            </ItemsControl.ItemContainerStyle>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                                                            HorizontalContentAlignment="Stretch"
                                                            VerticalContentAlignment="Stretch"
                                                            ToolTip="{Binding Compromisso.Titulo}"
                                                            CommandParameter="{Binding Compromisso}"
                                                            Command="{Binding DataContext.EditarCompromissoCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="caixa" Margin="2,1"
                                                                        CornerRadius="{StaticResource RadiusXs}"
                                                                        Padding="6,2"
                                                                        BorderThickness="1"
                                                                        Background="{DynamicResource AccentLightBrush}"
                                                                        BorderBrush="{DynamicResource AccentBrush}">
                                                                    <ContentPresenter/>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <!-- O choque, visível. Este é o
                                                                         motivo da grade existir. -->
                                                                    <DataTrigger Binding="{Binding Choca}" Value="True">
                                                                        <Setter TargetName="caixa" Property="Background"
                                                                                Value="{DynamicResource WarningBgBrush}"/>
                                                                        <Setter TargetName="caixa" Property="BorderBrush"
                                                                                Value="{DynamicResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Compromisso.Agendado}" Value="False">
                                                                        <Setter TargetName="caixa" Property="Background"
                                                                                Value="{DynamicResource SurfaceInsetBrush}"/>
                                                                        <Setter TargetName="caixa" Property="BorderBrush"
                                                                                Value="{DynamicResource BorderSubtleBrush}"/>
                                                                    </DataTrigger>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="caixa" Property="Effect"
                                                                                Value="{DynamicResource ShadowSoft}"/>
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                        <!-- Hora e título na MESMA linha, como
                                                             na célula do mês, e quebrando para
                                                             baixo quando o bloco é alto.

                                                             Em duas linhas fixas o título era a
                                                             segunda, e num compromisso de meia
                                                             hora ela não cabia: o bloco mostrava
                                                             só a hora, que é o que menos
                                                             identifica o compromisso (ela já
                                                             está na régua da esquerda). -->
                                                        <!-- O título vem no mesmo contraste da
                                                             hora: ele é o que identifica o
                                                             compromisso, e em cinza secundário
                                                             era a hora que gritava. -->
                                                        <TextBlock FontSize="11.5" TextWrapping="Wrap"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   LineHeight="15"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}">
                                                            <Run Text="{Binding Compromisso.HoraTexto, Mode=OneWay}"
                                                                 FontWeight="Bold"/>
                                                            <Run Text="{Binding Compromisso.Titulo, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ══ MÊS ═════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              Visibility="{Binding Modo, Converter={StaticResource StringEqualsToVis}, ConverterParameter=mes}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ItemsControl Grid.Row="0" ItemsSource="{Binding TitulosDosDias}" Margin="0,0,0,6">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="10.5" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Sem ScrollViewer: a UniformGrid divide a altura do painel entre as seis
                 semanas, e assim o mês ocupa a janela inteira em vez de ficar com uma altura
                 fixa e uma barra de rolagem para a última semana. -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding DiasDoMes}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="7"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch"
                                    MinHeight="64"
                                    CommandParameter="{Binding Data}"
                                    Command="{Binding DataContext.NovoNoDiaCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="celula" Margin="0,0,3,3" Padding="7,5"
                                                CornerRadius="{StaticResource RadiusSm}"
                                                BorderThickness="1"
                                                Background="{DynamicResource SurfaceGlassBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <!-- O dia de fora do mês fica apagado: ele está ali
                                                 para a semana ficar inteira, não para ser lido. -->
                                            <DataTrigger Binding="{Binding ForaDoMes}" Value="True">
                                                <Setter TargetName="celula" Property="Opacity" Value="0.45"/>
                                                <Setter TargetName="celula" Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                                <Setter TargetName="celula" Property="Background"
                                                        Value="{DynamicResource AccentSoftBrush}"/>
                                                <Setter TargetName="celula" Property="BorderBrush"
                                                        Value="{DynamicResource AccentBrush}"/>
                                            </DataTrigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="celula" Property="BorderBrush"
                                                        Value="{DynamicResource BorderStrongBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>

                                <StackPanel>
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="{Binding NumeroTexto}" FontSize="12"
                                                   HorizontalAlignment="Left">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EhHoje}" Value="True">
                                                            <Setter Property="FontWeight" Value="Bold"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                                   ToolTip="Tem choque de horário neste dia"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   Visibility="{Binding TemChoque, Converter={StaticResource BoolToVisConv}}"/>
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Itens}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                                                        HorizontalContentAlignment="Stretch"
                                                        ToolTip="{Binding Titulo}"
                                                        CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.EditarCompromissoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="etiqueta" Style="{StaticResource EtiquetaDoMes}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding Agendado}" Value="False">
                                                                    <Setter TargetName="etiqueta" Property="Background"
                                                                            Value="{DynamicResource SurfaceInsetBrush}"/>
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="etiqueta" Property="Background"
                                                                            Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                    <!-- Mesmo contraste do bloco da semana: o
                                                         título é o que identifica, e ele não
                                                         pode ser mais apagado que a hora. -->
                                                    <TextBlock FontSize="10.5" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextPrimaryBrush}">
                                                        <Run Text="{Binding HoraTexto, Mode=OneWay}" FontWeight="Bold"/>
                                                        <Run Text="{Binding Titulo, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="{Binding ExtrasTexto}" FontSize="9.5" Margin="5,1,0,0"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Visibility="{Binding TemExtras, Converter={StaticResource BoolToVisConv}}"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
