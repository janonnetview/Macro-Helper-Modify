<UserControl x:Class="MacroHelper.UI.Views.AjudaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <DockPanel>
        <Border DockPanel.Dock="Top" Background="Transparent"
                BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}" Padding="32,24,32,20">
            <StackPanel>
                <TextBlock Text="Central de Ajuda" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="{Binding SubtituloComVersao}" Style="{StaticResource PageSubtitleText}"/>
            </StackPanel>
        </Border>

        <!-- Recuo no filho, não como Padding: Padding no ScrollViewer recorta a sombra dos cartões (ver DashboardView). -->
        <ScrollViewer>
            <Grid MaxWidth="900" Margin="28,20,28,28">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <!-- Coluna esquerda: busca + FAQ accordion -->
                <StackPanel Grid.Column="0">
                    <!-- Busca -->
                    <Border Height="36" CornerRadius="10" Margin="0,0,0,12"
                            BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1"
                            Background="{DynamicResource InputBgBrush}">
                        <StackPanel Orientation="Horizontal" Margin="11,0">
                            <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Buscar na ajuda" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- FAQ accordion -->
                    <ItemsControl ItemsSource="{Binding Faqs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,6">
                                    <StackPanel>
                                        <!-- Cabeçalho clicável -->
                                        <ToggleButton IsChecked="{Binding Aberta}"
                                                      Command="{Binding ToggleAbertaCommand}"
                                                      Padding="18,14" Cursor="Hand"
                                                      Background="Transparent" BorderThickness="0"
                                                      HorizontalContentAlignment="Stretch">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="{TemplateBinding Background}"
                                                            Padding="{TemplateBinding Padding}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Pergunta}"
                                                                       FontSize="13" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextWrapping="Wrap" Margin="0,0,12,0"/>
                                                            <!-- Caret: down quando aberto, right quando fechado -->
                                                            <TextBlock Grid.Column="1"
                                                                       FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                                       VerticalAlignment="Top" Margin="0,2,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="&#xE76C;"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Aberta}" Value="True">
                                                                                <Setter Property="Text" Value="&#xE70D;"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <!-- Resposta (visível quando Aberta=True) -->
                                        <Border Visibility="{Binding Aberta, Converter={StaticResource BoolToVis}}"
                                                BorderThickness="0,1,0,0"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                Padding="18,10,18,14">
                                            <TextBlock Text="{Binding Resposta}" FontSize="12"
                                                       TextWrapping="Wrap" LineHeight="19"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Coluna direita: sidebar -->
                <StackPanel Grid.Column="2">
                    <!-- Atalhos úteis -->
                    <Border Style="{StaticResource CardStyle}" Padding="16,16" Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock Text="Atalhos úteis" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,11"/>
                            <!-- Ctrl+Espaço -->
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="8" Padding="8,3" Margin="0,0,10,0"
                                        Background="{DynamicResource SurfaceGlassBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        MinWidth="82" HorizontalAlignment="Center">
                                    <TextBlock Text="Ctrl+Espaço" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="busca rápida de macros" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Ctrl+Alt+1…9 -->
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="8" Padding="8,3" Margin="0,0,10,0"
                                        Background="{DynamicResource SurfaceGlassBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        MinWidth="82" HorizontalAlignment="Center">
                                    <TextBlock Text="Ctrl+Alt+1…9" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="insere a macro favorita" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- /atalho -->
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="8" Padding="8,3" Margin="0,0,10,0"
                                        Background="{DynamicResource SurfaceGlassBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        MinWidth="82" HorizontalAlignment="Center">
                                    <TextBlock Text="/atalho" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="dispara pelo texto digitado" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                            <!-- Esc -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border CornerRadius="8" Padding="8,3" Margin="0,0,10,0"
                                        Background="{DynamicResource SurfaceGlassBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                        MinWidth="82" HorizontalAlignment="Center">
                                    <TextBlock Text="Esc" FontFamily="Consolas" FontSize="11" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Center"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="fecha o buscador" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Ainda com dúvida? / Abrir chamado / Crédito -->
                    <Border Style="{StaticResource CardStyle}" Padding="16,16">
                        <StackPanel>
                            <TextBlock Text="Ainda com dúvida?" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="Fale com quem mantém o MacroHelper." FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap" Margin="0,0,0,12"/>
                            <!-- Abrir chamado -->
                            <Button Height="34" Margin="0,0,0,12"
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <TextBlock Text="&#xE715;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                <TextBlock Text="Abrir chamado" FontSize="12.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                            <!-- Divider + crédito -->
                            <Rectangle Height="1" Fill="{DynamicResource BorderSubtleBrush}" Margin="0,0,0,11"/>
                            <TextBlock Text="Desenvolvido por" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="Aline Martins" FontSize="12.5" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,1"/>
                            <TextBlock Text="Silk · aline.martins@silk.com.br" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
