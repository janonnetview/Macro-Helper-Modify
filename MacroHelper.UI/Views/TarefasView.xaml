<UserControl x:Class="MacroHelper.UI.Views.TarefasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MacroHelper.UI.Controls"
             xmlns:h="clr-namespace:MacroHelper.UI.Helpers"
             Background="Transparent">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="PageSlide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- ── Modal do formulário ── -->
        <Grid Panel.ZIndex="10" Visibility="{Binding MostrarFormulario, Converter={StaticResource BoolToVisConv}}">
            <!-- A cortina encosta na quina de baixo do painel de conteúdo, que é arredondada:
                 sem o mesmo raio ela pinta dois cantos quadrados para fora da curva. -->
            <Border Background="#99050810" CornerRadius="{StaticResource RadiusBottomXl}"/>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Width="560" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource FloatBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusXl}">
                <StackPanel Margin="28,24">
                    <Grid Margin="0,0,0,20">
                        <TextBlock Text="{Binding FormTitulo}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ButtonIconOnly}"
                                Command="{Binding FecharFormularioCommand}" Width="28" Height="28">
                            <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </Grid>

                    <Border Background="{DynamicResource DangerBgBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding FormErro, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding FormErro}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
                    </Border>

                    <TextBlock Text="O QUE PRECISA SER FEITO *" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="42" Margin="0,0,0,14"
                             Text="{Binding FormTexto, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="OBSERVAÇÕES (opcional)" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="72" Margin="0,0,0,14"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             VerticalContentAlignment="Top" Padding="12,8"
                             Text="{Binding FormObservacoes, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Text="PRIORIDADE" FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button Content="Baixa" CommandParameter="Baixa"
                                Command="{Binding DefinirPrioridadeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotaoOpcao}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormPrioridade}" Value="Baixa">
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Normal" CommandParameter="Normal"
                                Command="{Binding DefinirPrioridadeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotaoOpcao}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormPrioridade}" Value="Normal">
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Alta" CommandParameter="Alta"
                                Command="{Binding DefinirPrioridadeCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource BotaoOpcao}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding FormPrioridade}" Value="Alta">
                                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>

                    <!--
                        A lista sai do próprio enum, e o texto de cada item vem do converter —
                        os nomes em C# ("DiasUteis") não são o que se lê numa tela.
                    -->
                    <TextBlock Text="REPETIR: ao concluir, a próxima ocorrência é criada sozinha"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <ComboBox Margin="0,0,0,14" Height="38" HorizontalAlignment="Left" Width="240"
                              ItemsSource="{Binding RecorrenciasDisponiveis}"
                              SelectedItem="{Binding FormRecorrencia}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource RecorrenciaTexto}}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="PRAZO (opcional): só informativo, não avisa nada"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <WrapPanel Margin="0,0,0,8">
                        <c:SeletorDeData Margin="0,0,10,6" Texto="{Binding FormPrazo}"/>
                        <Button Content="Hoje"    CommandParameter="hoje"   Style="{StaticResource BotaoOpcao}"
                                Command="{Binding DefinirPrazoRapidoCommand}"/>
                        <Button Content="Amanhã"  CommandParameter="amanha" Style="{StaticResource BotaoOpcao}"
                                Command="{Binding DefinirPrazoRapidoCommand}"/>
                    </WrapPanel>

                    <TextBlock Text="LEMBRETE (opcional): aqui sim aparece uma notificação"
                               FontSize="10" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <!-- WrapPanel pela mesma razão da linha de prazo: com os três atalhos ao
                         lado dos dois campos, "Amanhã 9h" vazava para fora do modal. -->
                    <WrapPanel Margin="0,0,0,0">
                        <c:SeletorDeData Margin="0,0,8,6" Texto="{Binding FormLembreteData}"/>
                        <Grid Width="76" Height="38" Margin="0,0,10,6">
                            <TextBox Style="{StaticResource InputStyle}" MaxLength="5"
                                     h:MascaraTexto.Formato="Hora"
                                     Text="{Binding FormLembreteHora, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="hh:mm" FontSize="13" IsHitTestVisible="False"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="13,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding FormLembreteHora}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <!-- Os dois atalhos que dizem coisas diferentes: daqui a pouco, e
                             amanhã de manhã. O resto se escreve nos campos ao lado. -->
                        <Button Content="Em 1h"     CommandParameter="1h"      Style="{StaticResource BotaoOpcao}"
                                Command="{Binding DefinirLembreteRapidoCommand}"/>
                        <Button Content="Amanhã 9h" CommandParameter="amanha9" Style="{StaticResource BotaoOpcao}"
                                Command="{Binding DefinirLembreteRapidoCommand}"/>
                    </WrapPanel>
                    <Button Content="Remover lembrete" HorizontalAlignment="Left" Cursor="Hand"
                            Background="Transparent" BorderThickness="0" Margin="0,0,0,24"
                            FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                            Command="{Binding LimparLembreteCommand}"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Cancelar" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding FecharFormularioCommand}"
                                Margin="0,0,10,0" Width="100"/>
                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SalvarCommand}" Width="130">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <DockPanel>
            <!-- ── Cabeçalho ── -->
            <Border DockPanel.Dock="Top" Background="Transparent"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    Padding="32,24,32,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tarefas" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Text="O que precisa ser feito, com prazo e lembrete opcionais."
                                   Style="{StaticResource PageSubtitleText}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}"
                            Command="{Binding NovaTarefaCommand}" Height="38" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Nova Tarefa" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Margin="28,12,28,0" Style="{StaticResource ToastBorder}"
                    Visibility="{Binding Mensagem, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Mensagem}" Style="{StaticResource ToastTexto}"/>
            </Border>

            <!-- ── Filtros ── -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="28,16,28,0">
                <Button Command="{Binding DefinirFiltroCommand}" CommandParameter="abertas">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filtro}" Value="abertas">
                                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontSize="12"><Run Text="Abertas"/><Run Text="  "/><Run Text="{Binding TotalAbertas, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                </Button>

                <Button Command="{Binding DefinirFiltroCommand}" CommandParameter="hoje">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filtro}" Value="hoje">
                                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontSize="12"><Run Text="Hoje"/><Run Text="  "/><Run Text="{Binding TotalHoje, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                </Button>

                <Button Command="{Binding DefinirFiltroCommand}" CommandParameter="atrasadas">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filtro}" Value="atrasadas">
                                    <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontSize="12"><Run Text="Atrasadas"/><Run Text="  "/><Run Text="{Binding TotalAtrasadas, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                </Button>

                <Button Command="{Binding DefinirFiltroCommand}" CommandParameter="concluidas">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Filtro}" Value="concluidas">
                                    <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontSize="12"><Run Text="Concluídas"/><Run Text="  "/><Run Text="{Binding TotalConcluidas, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
                </Button>
            </StackPanel>

            <!-- ── Lista ── -->
            <!-- Recuo no filho, não como Padding: Padding no ScrollViewer recorta a sombra dos cartões (ver DashboardView). -->
            <ScrollViewer>
                <StackPanel Margin="28,14,28,28">
                    <!-- Estado vazio -->
                    <Border Style="{StaticResource EmptyStatePanel}" Margin="0,20,0,0"
                            Visibility="{Binding Tarefas.Count, Converter={StaticResource IntZeroToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Nada por aqui." FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Crie uma tarefa ou troque o filtro acima." FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Tarefas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource ListRow}" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Concluir -->
                                        <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  IsChecked="{Binding Concluida, Mode=OneWay}"
                                                  Command="{Binding DataContext.ConcluirCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding}"/>

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Titulo}" FontSize="13.5" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Concluida}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>

                                                <!-- Prioridade alta é a única que precisa gritar. O DataTrigger
                                                     compara direto com o enum: o WPF converte "Alta" para
                                                     PrioridadeTarefa.Alta pelo type converter. -->
                                                <Border Margin="8,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource DangerBgBrush}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Prioridade}" Value="Alta">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="Alta" Style="{StaticResource BadgeText}"
                                                               Foreground="{DynamicResource DangerBrush}"/>
                                                </Border>

                                                <!-- Recorrente precisa aparecer no cartão: concluir uma
                                                     tarefa dessas CRIA outra, e isso não pode ser
                                                     surpresa na hora em que a lista muda sozinha. -->
                                                <Border Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Background="{DynamicResource AccentLightBrush}"
                                                        Visibility="{Binding Recorrente, Converter={StaticResource BoolToVisConv}}">
                                                    <Border.Style>
                                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}"/>
                                                    </Border.Style>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="&#xE895;" FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="9" VerticalAlignment="Center" Margin="0,0,4,0"
                                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                                        <TextBlock Text="{Binding RecorrenciaTexto}"
                                                                   Style="{StaticResource BadgeText}"
                                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Text="{Binding Observacoes}" FontSize="11" Margin="0,4,0,0"
                                                       TextWrapping="Wrap" MaxHeight="34"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Visibility="{Binding Observacoes, Converter={StaticResource NullToVis}}"/>

                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <!-- Prazo -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,12,0"
                                                            Visibility="{Binding Prazo, Converter={StaticResource ObjNullToVis}}">
                                                    <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               VerticalAlignment="Center" Margin="0,0,5,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" VerticalAlignment="Center"
                                                               Text="{Binding Prazo, Converter={StaticResource DataAmigavel}}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Lembrete pendente -->
                                                <StackPanel Orientation="Horizontal"
                                                            Visibility="{Binding TemLembretePendente, Converter={StaticResource BoolToVisConv}}">
                                                    <TextBlock Text="&#xEA8F;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource AccentTextBrush}"
                                                               VerticalAlignment="Center" Margin="0,0,5,0"/>
                                                    <TextBlock FontSize="11" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource AccentTextBrush}"
                                                               Text="{Binding Lembrete, Converter={StaticResource DataAmigavel}, ConverterParameter=hora}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Ações -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource ButtonIconOnly}" ToolTip="Editar"
                                                    Width="30" Height="30" Margin="0,0,2,0"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.EditarTarefaCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>

                                            <Button ToolTip="Excluir" Cursor="Hand"
                                                    Width="30" Height="30" BorderThickness="0" Background="Transparent"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.ConfirmarExclusaoCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource EqualsToVis}" ConverterParameter="invert">
                                                        <Binding Path="DataContext.ConfirmandoExclusaoId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="Id"/>
                                                    </MultiBinding>
                                                </Button.Visibility>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                                <StackPanel.Visibility>
                                                    <MultiBinding Converter="{StaticResource EqualsToVis}">
                                                        <Binding Path="DataContext.ConfirmandoExclusaoId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="Id"/>
                                                    </MultiBinding>
                                                </StackPanel.Visibility>
                                                <Button Content="Confirmar" Style="{StaticResource ButtonSecondary}"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                        CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.ExcluirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0"/>
                                                <Button Style="{StaticResource ButtonIconOnly}"
                                                        Command="{Binding DataContext.CancelarExclusaoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Width="28" Height="28">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
