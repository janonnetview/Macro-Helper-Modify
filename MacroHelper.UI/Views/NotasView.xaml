<UserControl x:Class="MacroHelper.UI.Views.NotasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:MacroHelper.UI.Controls"
             xmlns:h="clr-namespace:MacroHelper.UI.Helpers"
             Background="Transparent">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="PageSlide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- ── Editor ── -->
        <Grid Panel.ZIndex="10" Visibility="{Binding MostrarEditor, Converter={StaticResource BoolToVisConv}}">
            <!-- A cortina encosta na quina de baixo do painel de conteúdo, que é arredondada:
                 sem o mesmo raio ela pinta dois cantos quadrados para fora da curva. -->
            <Border Background="#99050810" CornerRadius="{StaticResource RadiusBottomXl}"/>
            <!-- O editor ocupa o painel de conteúdo inteiro, menos uma margem: era uma caixa de
                 640px no meio da tela, e uma linha de "Server name: max-eba.(...).amazonaws.com"
                 quebrava no meio com o resto da tela vazio à volta. O MaxWidth existe para a
                 linha não virar uma faixa de 1600px numa tela larga — aí o olho se perde
                 voltando para o começo da linha seguinte. Entre os dois limites, quem manda é o
                 tamanho da janela. -->
            <Border HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Margin="32,24" MaxWidth="1180" MaxHeight="900"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource FloatBorderBrush}"
                    BorderThickness="1" CornerRadius="{StaticResource RadiusXl}">
                <DockPanel Margin="28,24">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <TextBlock Text="Nota" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Escrever e Ver, alternados. O texto com a marcacao e o desenho
                                 dela sao a MESMA nota vista de dois jeitos, e nao dois campos:
                                 por isso um par de chips, e nao um painel dividido. -->
                            <Button Command="{Binding AlternarVisualizacaoCommand}" Height="28" Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                                        <Setter Property="Height" Value="28"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorVisualizando}" Value="False">
                                                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Escrever" FontSize="11.5"/>
                            </Button>
                            <Button Command="{Binding AlternarVisualizacaoCommand}" Height="28" Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ChipFiltro}">
                                        <Setter Property="Height" Value="28"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding EditorVisualizando}" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock Text="Ver" FontSize="11.5"/>
                            </Button>
                            <!-- Fixar direto do editor: é onde se percebe que a nota merece o topo -->
                            <ToggleButton IsChecked="{Binding EditorFixada, Mode=TwoWay}"
                                          Background="Transparent" BorderThickness="0" Cursor="Hand"
                                          Width="28" Height="28" Margin="0,0,6,0" ToolTip="Fixar no topo">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bg" CornerRadius="8" Background="Transparent">
                                            <TextBlock x:Name="ic" Text="&#xE718;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ic" Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Button Style="{StaticResource ButtonIconOnly}"
                                    Command="{Binding FecharEditorCommand}" Width="28" Height="28">
                                <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <Border DockPanel.Dock="Top" Background="{DynamicResource DangerBgBrush}"
                            BorderBrush="{DynamicResource DangerBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="12,9" Margin="0,0,0,14"
                            Visibility="{Binding EditorErro, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding EditorErro}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DangerBrush}" FontSize="12"/>
                    </Border>

                    <TextBox DockPanel.Dock="Top" Style="{StaticResource InputStyle}" Height="44"
                             FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10"
                             Text="{Binding EditorTitulo, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Deixe em branco para usar a primeira linha do conteúdo"/>

                    <!-- A barra de formatacao. Escreve a marcacao por quem nao quer decora-la;
                         quem ja sabe digita direto e ignora a barra. Some na visualizacao: la
                         nao ha cursor onde inserir nada.

                         Os botoes sao os MESMOS da barra que aparece sobre a selecao, porque
                         sao o mesmo controle: o que estiver aqui estara la. -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding EditorVisualizando, Converter={StaticResource BoolToVisConv}, ConverterParameter=invert}">
                        <c:BarraDeMarcacao x:Name="BarraFixa"/>

                        <TextBlock Text="Selecione um trecho para formatar na hora. Ctrl+B negrito, Ctrl+I itálico, Ctrl+K link"
                                   FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                                HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancelar" Style="{StaticResource ButtonSecondary}"
                                Command="{Binding FecharEditorCommand}"
                                Margin="0,0,10,0" Width="100"/>
                        <Button Style="{StaticResource ButtonPrimary}"
                                Command="{Binding SalvarCommand}" Width="130">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,0,7,0"/>
                                <TextBlock Text="Salvar" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- O mesmo espaco, ocupado por um dos dois: o texto com a marcacao, ou
                         o desenho dela. -->
                    <Grid MinHeight="240">
                        <!-- Caixa de texto FORMATADO: a nota aparece como vai ficar, sem os
                             asteriscos à vista. O Markdown continua sendo o que se grava, e a
                             conversão nos dois sentidos é do EditorDeMarcacao. -->
                        <RichTextBox x:Name="CaixaDeConteudo" Style="{StaticResource EditorDeNota}"
                                     h:BarraAoSelecionar.Ligada="True"
                                     h:EditorDeMarcacao.Texto="{Binding EditorConteudo}"
                                     PreviewKeyDown="AtalhoDeMarcacao"
                                     Visibility="{Binding EditorVisualizando, Converter={StaticResource BoolToVisConv}, ConverterParameter=invert}"/>

                        <Border Style="{StaticResource InsetPanel}" Padding="16,12"
                                Visibility="{Binding EditorVisualizando, Converter={StaticResource BoolToVisConv}}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <!-- O painel se redesenha sozinho a cada mudanca do texto: a
                                     caixa de marcar reescreve o conteudo, e e por isso que
                                     marcar uma ja aparece marcada aqui. -->
                                <StackPanel h:MarkdownVisual.Conteudo="{Binding EditorConteudo}"
                                            h:MarkdownVisual.AoMarcar="{Binding AlternarItemCommand}"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel>
            <!-- ── Cabeçalho ── -->
            <Border DockPanel.Dock="Top" Background="Transparent"
                    BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderSubtleBrush}"
                    Padding="32,24,32,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Notas" Style="{StaticResource PageTitleText}"/>
                        <TextBlock Text="Anotações soltas do dia a dia. A busca ignora acentos e maiúsculas."
                                   Style="{StaticResource PageSubtitleText}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource ButtonPrimary}"
                            Command="{Binding NovaNotaCommand}" Height="38" Padding="16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Nova Nota" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" Margin="28,12,28,0" Style="{StaticResource ToastBorder}"
                    Visibility="{Binding Mensagem, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Mensagem}" Style="{StaticResource ToastTexto}"/>
            </Border>

            <!-- ── Busca ── -->
            <Grid DockPanel.Dock="Top" Margin="28,16,28,0">
                <TextBox Style="{StaticResource InputStyle}" Height="40" Padding="34,0,12,0"
                         Text="{Binding TermoBusca, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="14,0,0,0" IsHitTestVisible="False"/>
                <!-- Placeholder: só aparece com o campo vazio. A Visibility fica no Style,
                     nunca como atributo — um valor local venceria o DataTrigger. -->
                <TextBlock Text="Buscar nas notas..." FontSize="13" IsHitTestVisible="False"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="34,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TermoBusca}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- ── Lista ── -->
            <!-- Recuo no filho, não como Padding: Padding no ScrollViewer recorta a sombra dos cartões (ver DashboardView). -->
            <ScrollViewer>
                <StackPanel Margin="28,14,28,28">
                    <Border Style="{StaticResource EmptyStatePanel}" Margin="0,20,0,0"
                            Visibility="{Binding Notas.Count, Converter={StaticResource IntZeroToVis}}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="&#xE70B;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Nenhuma nota por aqui" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Crie uma nota ou limpe a busca." FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Notas}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- O cartão inteiro abre a nota, e por isso ele é um Button com o
                                     cartão por template: dentro de um MouseBinding o RelativeSource
                                     não resolve (InputBinding não está na árvore visual) e o clique
                                     ficaria sem efeito, calado. Os botões da direita seguem fazendo o
                                     que faziam — quem clica neles nunca chega neste. -->
                                <Button Cursor="Hand" Focusable="False" FocusVisualStyle="{x:Null}"
                                        HorizontalContentAlignment="Stretch"
                                        CommandParameter="{Binding}"
                                        Command="{Binding DataContext.AbrirNotaCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Style="{StaticResource ListRow}" Padding="18,15">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,6,0"
                                                           Visibility="{Binding Fixada, Converter={StaticResource BoolToVisConv}}"/>
                                                <TextBlock Text="{Binding Titulo}" FontSize="13.5" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Resumo}" FontSize="11.5" Margin="0,5,0,0"
                                                       TextWrapping="Wrap" MaxHeight="34"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock FontSize="10.5" Margin="0,6,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       Text="{Binding DataAtualizacao, Converter={StaticResource DataAmigavel}, ConverterParameter=hora}"
                                                       Visibility="{Binding DataAtualizacao, Converter={StaticResource ObjNullToVis}}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                                            <Button Style="{StaticResource ButtonIconOnly}" ToolTip="Fixar no topo"
                                                    Width="30" Height="30" Margin="0,0,2,0"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.FixarCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Fixada}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Button>

                                            <Button Style="{StaticResource ButtonIconOnly}" ToolTip="Copiar conteúdo"
                                                    Width="30" Height="30" Margin="0,0,2,0"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.CopiarConteudoCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>

                                            <Button Style="{StaticResource ButtonIconOnly}" ToolTip="Abrir"
                                                    Width="30" Height="30" Margin="0,0,2,0"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.AbrirNotaCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Button>

                                            <Button ToolTip="Excluir" Cursor="Hand"
                                                    Width="30" Height="30" BorderThickness="0" Background="Transparent"
                                                    CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.ConfirmarExclusaoCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}">
                                                <Button.Visibility>
                                                    <MultiBinding Converter="{StaticResource EqualsToVis}" ConverterParameter="invert">
                                                        <Binding Path="DataContext.ConfirmandoExclusaoId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="Id"/>
                                                    </MultiBinding>
                                                </Button.Visibility>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" CornerRadius="8" Background="{TemplateBinding Background}">
                                                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>

                                            <StackPanel Orientation="Horizontal" Margin="2,0,0,0">
                                                <StackPanel.Visibility>
                                                    <MultiBinding Converter="{StaticResource EqualsToVis}">
                                                        <Binding Path="DataContext.ConfirmandoExclusaoId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="Id"/>
                                                    </MultiBinding>
                                                </StackPanel.Visibility>
                                                <Button Content="Confirmar" Style="{StaticResource ButtonSecondary}"
                                                        Foreground="{DynamicResource DangerBrush}"
                                                        CommandParameter="{Binding}"
                                                        Command="{Binding DataContext.ExcluirCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Height="28" Padding="10,0" FontSize="11" Margin="0,0,4,0"/>
                                                <Button Style="{StaticResource ButtonIconOnly}"
                                                        Command="{Binding DataContext.CancelarExclusaoCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        Width="28" Height="28">
                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
