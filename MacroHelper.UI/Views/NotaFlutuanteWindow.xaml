<Window x:Class="MacroHelper.UI.Views.NotaFlutuanteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MacroHelper.UI.Controls"
        xmlns:h="clr-namespace:MacroHelper.UI.Helpers"
        Width="640" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!--
            Os dois botões do rodapé, definidos aqui em vez de reaproveitar ButtonPrimary e
            ButtonSecondary do App.xaml.

            O ButtonPrimary carrega um DropShadowEffect permanente (Opacity=0, ligado só na
            animação de hover). Qualquer Effect joga o elemento numa superfície intermediária
            e o WPF desliga o ClearType ali dentro: num botão de 38px de altura quase não se
            vê, num de 30 o texto fica visivelmente borrado ao lado de um botão sem efeito.
            Aqui não há Effect nem RenderTransform, e o texto sai nítido.
        -->
        <Style x:Key="BotaoNota" TargetType="Button">
            <Setter Property="FontSize"         Value="11.5"/>
            <Setter Property="FontWeight"       Value="SemiBold"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="Height"           Value="30"/>
            <Setter Property="Padding"          Value="16,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="Foreground"       Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="1" BorderBrush="{DynamicResource BorderStrongBrush}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource SurfaceElevatedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotaoNotaPrimario" TargetType="Button" BasedOn="{StaticResource BotaoNota}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
            <Setter Property="Padding"    Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="8" SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource AccentHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Sem sombra, aqui e nas outras flutuantes: quem separa a janela do que está atrás é a
         borda do cartão. A sombra do sistema sai no MolduraNativa, chamado no construtor. -->
    <Border CornerRadius="{StaticResource RadiusWindow}"
            Background="{DynamicResource FloatSurfaceBrush}"
            BorderBrush="{DynamicResource FloatBorderBrush}" BorderThickness="1">
        <StackPanel>

            <!-- Cabeçalho: o título é editável no lugar, sem campo separado. Também é a alça de
                 arraste da janela — o clique no TextBox e nos botões continua funcionando normal,
                 porque os dois marcam o evento como tratado antes de borbulhar até aqui. -->
            <Border Padding="18,13,12,11" BorderThickness="0,0,0,1"
                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="&#xE70B;" FontFamily="Segoe MDL2 Assets"
                               FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextBrush}"/>

                    <TextBox x:Name="TxtTitulo" Grid.Column="1"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource AccentBrush}"
                             FontSize="15" FontWeight="SemiBold"
                             VerticalContentAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">

                        <!-- Escrever e Ver, no mesmo botão: o texto com a marcação e o desenho dela
                             são a MESMA nota vista de dois jeitos. Apertado, mostra o desenho — com
                             as caixas de marcar clicáveis, que é o que faz a lista de conferência
                             valer a pena numa nota aberta ao lado do trabalho. -->
                        <ToggleButton x:Name="BtnVer" Click="BtnVer_Click"
                                      Width="28" Height="28" Cursor="Hand" Margin="0,0,2,0"
                                      Background="Transparent" BorderThickness="0"
                                      ToolTip="Ver a nota formatada">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="bg" CornerRadius="8" SnapsToDevicePixels="True"
                                            Background="{TemplateBinding Background}">
                                        <TextBlock x:Name="ic" Text="&#xE890;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{DynamicResource SurfaceElevatedBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{DynamicResource AccentLightBrush}"/>
                                            <Setter TargetName="ic" Property="Foreground"
                                                    Value="{DynamicResource AccentTextBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Button Click="BtnFechar_Click"
                                Width="28" Height="28" Cursor="Hand"
                                Background="Transparent" BorderThickness="0"
                                ToolTip="Fechar (Esc)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bg" CornerRadius="8" SnapsToDevicePixels="True"
                                            Background="{TemplateBinding Background}">
                                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bg" Property="Background"
                                                    Value="{DynamicResource SurfaceElevatedBrush}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Padding="18,14,12,14">
                <DockPanel>
                    <!-- A barra de formatação é a MESMA da tela de Notas — o mesmo controle,
                         os mesmos botões. Aqui ela some na visualização: lá não há cursor
                         onde inserir nada. -->
                    <c:BarraDeMarcacao x:Name="Barra" DockPanel.Dock="Top"
                                       HorizontalAlignment="Left" Margin="-4,0,0,8"/>

                    <!-- O mesmo espaço, ocupado por um dos dois: o texto com a marcação, ou
                         o desenho dela. MinHeight para a nota de uma linha não virar uma
                         fresta; MaxHeight para a de cinquenta não empurrar o rodapé para
                         fora da tela. -->
                    <Grid MinHeight="210" MaxHeight="420">
                        <!-- Caixa de texto FORMATADO: a nota aparece como vai ficar, sem os
                             asteriscos à vista. O Markdown continua sendo o que se grava, e
                             quem converte nos dois sentidos é o EditorDeMarcacao. -->
                        <RichTextBox x:Name="TxtConteudo"
                                     Style="{StaticResource EditorDeNotaSemMoldura}"
                                     h:BarraAoSelecionar.Ligada="True"
                                     h:EditorDeMarcacao.Ligado="True"/>

                        <ScrollViewer x:Name="Previa" Visibility="Collapsed"
                                      VerticalScrollBarVisibility="Auto">
                            <!-- O painel se redesenha a cada mudança do texto: a caixa de
                                 marcar reescreve o conteúdo, e é por isso que marcar uma já
                                 aparece marcada aqui. -->
                            <StackPanel x:Name="PainelDaPrevia"/>
                        </ScrollViewer>
                    </Grid>
                </DockPanel>
            </Border>

            <Border Padding="14,10" BorderThickness="0,1,0,0"
                    BorderBrush="{DynamicResource BorderStrongBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Apagar fica longe do Salvar e pede um segundo clique. -->
                    <Button x:Name="BtnApagar" Grid.Column="0" Content="Apagar"
                            Click="BtnApagar_Click" Style="{StaticResource BotaoNota}"
                            Padding="12,0" Foreground="{DynamicResource DangerBrush}"/>

                    <c:LinhaDeEstado x:Name="Estado" Grid.Column="1"
                                    Margin="12,0" FontSize="9.5"
                                    VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="Inserir no app" Click="BtnInserir_Click"
                                Style="{StaticResource BotaoNota}" Margin="0,0,7,0"/>
                        <Button Content="Salvar" Click="BtnSalvar_Click"
                                Style="{StaticResource BotaoNotaPrimario}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</Window>
