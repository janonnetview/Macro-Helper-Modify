<UserControl x:Class="MacroHelper.UI.Views.ConfiguracoesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             PreviewKeyDown="ConfiguracoesView_PreviewKeyDown">

    <UserControl.RenderTransform>
        <TranslateTransform x:Name="PageSlide"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.22"/>
                <DoubleAnimation Storyboard.TargetName="PageSlide" Storyboard.TargetProperty="Y" From="10" To="0" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
            </Storyboard></BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- Coluna centrada: encostada à esquerda, a tela deixava um vazio de 400px do lado
             direito em qualquer monitor grande. -->
        <StackPanel MaxWidth="760" Margin="40,32,40,40" HorizontalAlignment="Center">

            <TextBlock Text="Configurações" Style="{StaticResource PageTitleText}" Margin="0,0,0,4"/>
            <TextBlock Text="Personalize o SK MacroHelper conforme suas preferências."
                       Style="{StaticResource PageSubtitleText}"
                       Margin="0,0,0,30"/>

            <!-- Toast -->
            <Border Margin="0,0,0,18" Style="{StaticResource ToastBorder}"
                    Visibility="{Binding Mensagem, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding Mensagem}" Style="{StaticResource ToastTexto}"/>
            </Border>

            <!-- ── TEMA ── -->
            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource IconTileSmall}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Aparência" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Sistema -->
                        <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="{StaticResource RadiusLg}"
                                Padding="16,20" Cursor="Hand" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                    <Style.Triggers>
                                        <!-- Hover antes do escolhido: os dois mexem na mesma
                                             propriedade, e quem vem depois vence. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding TemaSelecionado}" Value="Sistema">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding AplicarTemaCommand}"
                                              CommandParameter="Sistema"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Sistema" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Segue o Windows" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Claro -->
                        <Border Grid.Column="1" Margin="4,0" CornerRadius="{StaticResource RadiusLg}"
                                Padding="16,20" Cursor="Hand" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                    <Style.Triggers>
                                        <!-- Hover antes do escolhido: os dois mexem na mesma
                                             propriedade, e quem vem depois vence. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding TemaSelecionado}" Value="Claro">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding AplicarTemaCommand}"
                                              CommandParameter="Claro"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Claro" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Interface clara" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                        <!-- Escuro -->
                        <Border Grid.Column="2" Margin="8,0,0,0" CornerRadius="{StaticResource RadiusLg}"
                                Padding="16,20" Cursor="Hand" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource SurfaceGlassBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtleBrush}"/>
                                    <Style.Triggers>
                                        <!-- Hover antes do escolhido: os dois mexem na mesma
                                             propriedade, e quem vem depois vence. -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding TemaSelecionado}" Value="Escuro">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            <Setter Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.InputBindings>
                                <MouseBinding MouseAction="LeftClick"
                                              Command="{Binding AplicarTemaCommand}"
                                              CommandParameter="Escuro"/>
                            </Border.InputBindings>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="&#xE708;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="Escuro" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Interface escura" FontSize="10" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── APARÊNCIA AVANÇADA / IDIOMA ── -->
            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource IconTileSmall}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Personalização" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="COR DE DESTAQUE" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,8"/>
                    <!-- WrapPanel, e não StackPanel horizontal: a paleta tem doze cores e numa
                         fileira só as últimas ficavam fora da tela. Por isso o ItemsControl
                         também não mora mais dentro de um StackPanel horizontal: ali dentro a
                         largura disponível é infinita e o WrapPanel nunca quebraria. -->
                    <ItemsControl ItemsSource="{Binding CoresAccentDisponiveis}" Margin="0,0,0,10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Button, e não Border com MouseBinding: dentro de um
                                     InputBinding o RelativeSource não resolve (ele não está
                                     na árvore visual), e escolher a cor não fazia nada. -->
                                <!-- A bolinha mostra a versão da cor do tema em uso; o que vai
                                     no comando (e para o disco) é o NOME dela. -->
                                <Button Width="34" Height="34" Margin="0,0,8,8" Cursor="Hand"
                                        Focusable="False" FocusVisualStyle="{x:Null}"
                                        ToolTip="{Binding Nome}"
                                        Background="{Binding Hex}"
                                        CommandParameter="{Binding Nome}"
                                        Command="{Binding DataContext.AplicarCorAccentCommand,
                                                  RelativeSource={RelativeSource AncestorType=UserControl}}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <!--
                                                    O anel de fora é o estado "esta é a cor em
                                                    uso". Antes não havia nenhum: uma dúzia de
                                                    bolinhas coloridas e nenhuma pista de qual
                                                    estava valendo — o usuário só descobria
                                                    olhando o resto da tela.

                                                    Ele é um elemento separado (e não a borda da
                                                    bolinha) porque o que se compara é o nome do
                                                    item com o nome salvo, e isso pede um
                                                    MultiBinding — que só cabe em Visibility.
                                                -->
                                                <Border x:Name="anel"
                                                        CornerRadius="{StaticResource RadiusPill}"
                                                        BorderThickness="2"
                                                        BorderBrush="{DynamicResource TextPrimaryBrush}">
                                                    <Border.Visibility>
                                                        <MultiBinding Converter="{StaticResource EqualsToVis}">
                                                            <Binding Path="Nome"/>
                                                            <Binding Path="DataContext.CorAccentSelecionada"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        </MultiBinding>
                                                    </Border.Visibility>
                                                </Border>
                                                <Border x:Name="bola" Margin="4"
                                                        CornerRadius="{StaticResource RadiusPill}"
                                                        BorderThickness="1"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="anel" Property="Visibility" Value="Visible"/>
                                                    <Setter TargetName="anel" Property="BorderBrush"
                                                            Value="{DynamicResource BorderStrongBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                        Havia aqui um par de botões "Português (BR) / English" que gravava a
                        escolha numa preferência que NADA no app lia: não existe tradução, e
                        clicar em English só mostrava "reinicie para aplicar" e devolvia a mesma
                        tela em português. Um controle que promete e não cumpre é pior que a
                        ausência dele, então saiu. Quando houver tradução de verdade, volta.
                    -->

                    <Button Style="{StaticResource ButtonSecondary}"
                            Command="{Binding RefazerTourCommand}"
                            HorizontalAlignment="Left" Height="36" Padding="14,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                                       VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Rever tour de boas-vindas" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- ── GATILHO E DIGITAÇÃO ── -->
            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource IconTileSmall}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Gatilho e Digitação" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="PREFIXO DO GATILHO" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="40" MaxLength="1"
                             Text="{Binding GatilhoPrefixo, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,4" Width="80" HorizontalAlignment="Left"/>
                    <TextBlock Text="Caractere usado para acionar a sugestão de macros. Padrão: /"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="APLICATIVOS NO MODO DIGITAÇÃO (FALLBACK)" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource InputStyle}" Height="40"
                             Text="{Binding AppsModoDigitacao, UpdateSourceTrigger=PropertyChanged}"
                             Margin="0,0,0,4"/>
                    <TextBlock Text="Nomes de janela separados por ; (ex: Terminal;PuTTY). Nesses apps, o texto é digitado em vez de colado."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,16">
                        <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                            <TextBlock Text="Sugestão proativa de macro" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Avisa quando você digita a mesma frase repetidamente, sugerindo criar uma macro. Só considera frases de três palavras ou mais, e esquece o que foi digitado ao trocar de janela."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding SugestaoProativaIA}"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                            <TextBlock Text="Histórico da área de transferência" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Guarda os últimos 50 textos copiados na aba Copiados do Ctrl+Espaço. Fica tudo no seu computador, e o que um gerenciador de senhas copia não é guardado. Desligar para a captura sem apagar o que já existe."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                  IsChecked="{Binding HistoricoClipboardAtivo}"/>
                    </Grid>

                    <Button Style="{StaticResource ButtonPrimary}"
                            Command="{Binding SalvarGatilhoCommand}"
                            HorizontalAlignment="Left" Content="Salvar" Width="100" Height="38"/>
                </StackPanel>
            </Border>

            <!-- ── COMPORTAMENTO ── -->
            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,20">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Style="{StaticResource IconTileSmall}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Comportamento" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Substitui o nome que antes vinha da conta logada -->
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                        <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                            <TextBlock Text="Seu nome" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Usado no placeholder {usuario} das macros e na saudação do Início."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,3,0,8" TextWrapping="Wrap"/>
                            <TextBox Style="{StaticResource InputStyle}" Height="40" Width="280"
                                     HorizontalAlignment="Left" MaxLength="60"
                                     Text="{Binding SeuNome, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Border>

                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                                <TextBlock Text="Iniciar com o Windows" FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="O MacroHelper inicia automaticamente ao ligar o PC."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding IniciarComWindows}"/>
                        </Grid>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                        <Grid>
                            <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                                <TextBlock Text="Minimizar para a bandeja do sistema"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="Ao fechar, o app continua rodando em segundo plano."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                           Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center"
                                      IsChecked="{Binding MinimizarParaBandeja}"/>
                        </Grid>
                    </Border>

                    <!-- Notificações: sem um teste, não há como saber que elas não estão chegando -->
                    <Grid>
                        <StackPanel MaxWidth="440" HorizontalAlignment="Left">
                            <TextBlock Text="Notificações de lembrete"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock TextWrapping="Wrap" FontSize="11" Margin="0,3,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Text="Os lembretes das tarefas aparecem como notificação do Windows, e só chegam com o app aberto (ele pode ficar na bandeja). Se o teste não mostrar nada, as notificações do SK MacroHelper estão desligadas nas configurações do Windows."/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                Style="{StaticResource ButtonSecondary}" Height="34" Padding="14,0"
                                FontSize="12" Content="Testar notificação"
                                Command="{Binding TestarNotificacaoCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ── ATALHOS DE TECLADO ── -->
            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Border Style="{StaticResource IconTileSmall}" Margin="0,0,10,0">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Atalhos de Teclado" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="Clique no atalho e pressione a nova combinação de teclas."
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,14"/>

                    <!-- Busca rápida -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Busca rápida" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Abre o buscador de macros em qualquer lugar do Windows."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="170" Height="36"
                                Command="{Binding IniciarCapturaAtalhoCommand}" CommandParameter="busca">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CapturandoAtalho}" Value="busca">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Consolas" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding AtalhoBuscaTexto}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CapturandoAtalho}" Value="busca">
                                                <Setter Property="Text" Value="Pressione uma tecla..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <!-- Abrir janela principal: combinação fixa, por isso só é exibida -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Abrir janela principal" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Chama a janela do app para a frente, mesmo com ele na bandeja. Se já estiver na frente, minimiza."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Width="170" Height="36" CornerRadius="8"
                                Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderStrongBrush}" BorderThickness="1">
                            <TextBlock Text="Ctrl + Shift + Espaço" FontFamily="Consolas" FontSize="12"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Repetir última macro -->
                    <Grid Margin="0,0,0,12">
                        <StackPanel HorizontalAlignment="Left">
                            <TextBlock Text="Repetir última macro" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Sempre com o prefixo Ctrl + Alt. Você escolhe a tecla final."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Width="170" Height="36"
                                Command="{Binding IniciarCapturaAtalhoCommand}" CommandParameter="repetir">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ButtonSecondary}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CapturandoAtalho}" Value="repetir">
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock FontFamily="Consolas" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding AtalhoRepetirTexto}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CapturandoAtalho}" Value="repetir">
                                                <Setter Property="Text" Value="Pressione uma tecla..."/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <Button Content="Restaurar padrão" Style="{StaticResource ButtonSecondary}"
                            Command="{Binding RestaurarAtalhosPadraoCommand}"
                            HorizontalAlignment="Left" Width="140" Height="34" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ── SAÚDE DO APP ── -->
            <Border Style="{StaticResource SectionPanel}" Margin="0,0,0,14">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal">
                            <Border Style="{StaticResource IconTileSmall}" Margin="0,0,10,0">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Saúde do App" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button HorizontalAlignment="Right" Style="{StaticResource ButtonIconOnly}"
                                Command="{Binding CarregarSaudeCommand}" ToolTip="Atualizar">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Button>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,12">
                            <TextBlock Text="MEMÓRIA EM USO" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding MemoriaTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,8,12">
                            <TextBlock Text="VERSÃO" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding VersaoAppTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                            <TextBlock Text="MACROS" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding TotalMacrosHealth, Mode=OneWay}"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                                BorderThickness="0,1,0,0" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                Margin="0,0,0,12" Padding="0,12,0,0">
                            <TextBlock Text="Recursos do computador (desta sessão)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                        <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="CPU" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CpuTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="MEMÓRIA DO COMPUTADOR" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding MemoriaSistemaTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,0,0,0">
                            <TextBlock Text="DISCO" FontSize="9" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding DiscoTexto}" FontSize="14" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Salvar -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ButtonPrimary}"
                        Command="{Binding SalvarConfiguracoesCommand}"
                        Padding="24,0" Height="42" FontSize="14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                   VerticalAlignment="Center" Margin="0,0,9,0"/>
                        <TextBlock Text="Salvar configurações" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
