<Window x:Class="MacroHelper.UI.Views.MainWindow" x:Name="Janela"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:MacroHelper.UI.ViewModels"
        xmlns:views="clr-namespace:MacroHelper.UI.Views"
        xmlns:conv="clr-namespace:MacroHelper.UI.Converters"
        Title="SK MacroHelper" Height="760" Width="1200" xml:lang="pt-BR"
        MinHeight="600" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        WindowStyle="None" AllowsTransparency="True"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        Icon="/Resources/app.ico"
        Activated="Window_Activated">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!--
            ITEM DE NAVEGAÇÃO

            O item ativo NÃO é um bloco pintado de verde. Ele é: vidro um pouco mais claro,
            uma barra fina de accent encostada na borda esquerda, o ícone em accent e o texto
            em branco. Quatro sinais fracos somam mais hierarquia do que um retângulo colorido,
            e a barra lateral inteira continua acromática.

            O BorderBrush é reaproveitado como "carrier" da cor da barra — quem liga o item
            (os DataTriggers lá embaixo) só troca esse pincel, e o template desenha.
        -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="bg" CornerRadius="{StaticResource RadiusMd}"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="1" BorderBrush="Transparent"
                                    Margin="8,0"/>
                            <!--
                                Marca do item ativo. Encostada na parede do painel ela lia como
                                um fio cortado pela borda; agora é uma pastilha inteira, com as
                                duas pontas arredondadas e uma folga de 3px do canto.
                            -->
                            <Border x:Name="accentBar" Width="3" Height="18" HorizontalAlignment="Left"
                                    Margin="3,0,0,0" CornerRadius="{StaticResource RadiusPill}"
                                    Background="{TemplateBinding BorderBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="24,0,12,0">
                                <TextBlock x:Name="icon"
                                           FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                           Text="{TemplateBinding Tag}"
                                           Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background"
                                        Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                <Setter TargetName="icon" Property="Foreground"
                                        Value="{DynamicResource SidebarTextActiveBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush"
                                        Value="{DynamicResource BorderStrongBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sub-item de navegação (nível 2, indentado, sem barra de accent) -->
        <Style x:Key="NavSubItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="{StaticResource RadiusSm}"
                                Background="{TemplateBinding Background}" Margin="8,0">
                            <ContentPresenter VerticalAlignment="Center" Margin="42,0,12,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Item do menu do avatar (popup) -->
        <Style x:Key="AvatarMenuItem" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="{StaticResource RadiusSm}"
                                Background="{TemplateBinding Background}" Padding="11,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botão da barra de título. O fechar é o único que ganha cor, e só no hover. -->
        <Style x:Key="ChromeButton" TargetType="Button" BasedOn="{StaticResource ButtonIconOnly}">
            <Setter Property="Width" Value="34"/>
            <Setter Property="Height" Value="30"/>
        </Style>
    </Window.Resources>

    <!--
        ══════════════════════════════════════════════════════════════════════════════
        A JANELA EM TRÊS CAMADAS

            1. casca            — o fundo ambiente, arredondado, com duas luzes de canto
            2. painéis de vidro — barra lateral e painel de conteúdo, separados por um vão
                                  de 12px, cada um com sua borda de 1px
            3. conteúdo         — as telas, todas transparentes, compostas sobre o vidro

        A janela é translúcida de verdade (AllowsTransparency), e a casca ocupa toda ela:
        o limite da janela É a curva do painel, sem moldura nem folga em volta. É o que faz
        os cantos ficarem redondos de verdade sobre a área de trabalho — o arredondamento do
        DWM no Windows 11 é de uns 8px e não chega perto de 28.

        Maximizada, o canto redondo deixaria quatro entalhes vazios nos cantos da tela, por
        isso o gatilho lá embaixo zera o raio.
    -->
    <Grid>
        <!-- ── 1. CASCA ── -->
        <!--
            Sem borda de 1px. O contorno claro que existia aqui virava um fio esbranquiçado
            correndo pela curva — sobre uma janela clara atrás, era a coisa mais visível do
            canto. Sem ele a beirada é só o antisserrilhado da curva: a casca escura entrando
            no que estiver atrás, que é o que uma janela arredondada de verdade faz.
        -->
        <Border x:Name="Casca"
                Background="{DynamicResource AmbientBackdropBrush}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="{StaticResource RadiusWindow}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding WindowState, ElementName=Janela}" Value="Maximized">
                            <Setter Property="CornerRadius" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <!-- As luzes são fundo de Border com raio: a curva da casca é que recorta o
                     brilho. Ver o comentário das GlowCorner* no Dark.xaml. -->
                <Border CornerRadius="{Binding CornerRadius, ElementName=Casca}" IsHitTestVisible="False"
                        Background="{DynamicResource GlowCornerTopLeftBrush}"/>
                <Border CornerRadius="{Binding CornerRadius, ElementName=Casca}" IsHitTestVisible="False"
                        Background="{DynamicResource GlowCornerBottomRightBrush}"/>

                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ══════════════ SIDEBAR ══════════════ -->
                    <Border x:Name="Sidebar" Grid.Column="0" Margin="0,0,12,0"
                            Background="{DynamicResource SurfaceGlassBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXl}"
                            Effect="{DynamicResource ShadowSoft}">
                        <Grid>
                            <DockPanel>

                                <!-- Logo -->
                                <Border DockPanel.Dock="Top" Padding="20,22,20,20">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- O único lugar da barra lateral com verde de marca. -->
                                        <Border Width="40" Height="40" CornerRadius="{StaticResource RadiusMd}"
                                                Margin="0,0,13,0"
                                                Background="{DynamicResource AccentLightBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                ToolTip="SK MacroHelper">
                                            <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="17"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Nome e subtítulo numa pilha só, centrada pela ALTURA do
                                             ladrilho ao lado: é o alinhamento óptico, as duas linhas
                                             juntas é que fazem par com ele, não o nome sozinho.

                                             "SK" em negrito e "Macro" no peso normal são dois Run
                                             dentro do MESMO TextBlock, e não dois TextBlock lado a
                                             lado: assim o espaço entre as palavras é o espaço da
                                             fonte, e a linha quebra (se um dia couber menos) como
                                             uma frase e não como duas caixas. -->
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock FontSize="16" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Run Text="SK" FontWeight="Bold"/><Run Text=" Macro"/>
                                            </TextBlock>
                                            <TextBlock Text="Macro Helper" FontSize="11.5" Margin="0,1,0,0"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- ── Footer: status + avatar ── -->
                                <Border DockPanel.Dock="Bottom" Padding="0,10,0,10">
                                    <StackPanel>
                                        <Border Style="{StaticResource RowSeparator}" Margin="16,0,16,10"/>

                                        <!-- Status: hook ativo + Ctrl+Espaço -->
                                        <Grid Margin="20,2,20,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="6" Height="6"
                                                     Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center">
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                    From="1" To="0.25" Duration="0:0:1.6" AutoReverse="True">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <SineEase EasingMode="EaseInOut"/>
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>
                                            <TextBlock Grid.Column="1" Text="Hook ativo" FontSize="10.5" Margin="9,0,0,0"
                                                       Foreground="{DynamicResource SidebarMutedBrush}" VerticalAlignment="Center"/>
                                            <Border Grid.Column="2" Style="{StaticResource KbdChip}">
                                                <TextBlock Text="Ctrl+Espaço" Style="{StaticResource KbdChipText}"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                            </Border>
                                        </Grid>

                                        <!-- Avatar toggle (abre o popup de menu) -->
                                        <ToggleButton x:Name="AvatarToggle"
                                                      IsChecked="{Binding AvatarMenuAberto, Mode=TwoWay}"
                                                      Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                      HorizontalContentAlignment="Stretch" Margin="8,0,8,0"
                                                      FocusVisualStyle="{x:Null}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="bg" CornerRadius="{StaticResource RadiusMd}" Padding="10,8"
                                                            Background="{TemplateBinding Background}"
                                                            BorderThickness="1" BorderBrush="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                                                    Margin="0,0,11,0"
                                                                    Background="{DynamicResource SurfaceGlassActiveBrush}"
                                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                    BorderThickness="1">
                                                                <TextBlock Text="{Binding NomeUsuario, Converter={StaticResource NameInitials}}"
                                                                           FontSize="11.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <TextBlock Grid.Column="1" Text="{Binding NomeUsuario}"
                                                                       FontSize="12.5" FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource SidebarTextActiveBrush}"
                                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Grid.Column="2" Text="&#xE70E;"
                                                                       FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                                       Foreground="{DynamicResource SidebarMutedBrush}"
                                                                       VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background"
                                                                    Value="{DynamicResource SurfaceGlassHoverBrush}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="bg" Property="Background"
                                                                    Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                                            <Setter TargetName="bg" Property="BorderBrush"
                                                                    Value="{DynamicResource BorderSubtleBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>

                                        <!-- Popup do menu de avatar -->
                                        <Popup PlacementTarget="{Binding ElementName=AvatarToggle}"
                                               Placement="Top"
                                               IsOpen="{Binding AvatarMenuAberto, Mode=TwoWay}"
                                               StaysOpen="False"
                                               AllowsTransparency="True"
                                               DataContext="{Binding DataContext, ElementName=Sidebar}">
                                            <!-- A margem existe para a sombra caber dentro do Popup. -->
                                            <Border Margin="16,16,16,10">
                                                <Border Background="{DynamicResource PopupBgBrush}"
                                                        BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                        CornerRadius="{StaticResource RadiusLg}" Width="222" Padding="6"
                                                        Effect="{DynamicResource ShadowGlass}">
                                                    <StackPanel>
                                                        <Button Style="{StaticResource AvatarMenuItem}"
                                                                Command="{Binding NavigarParaConfiguracoesCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                                                <TextBlock Text="Configurações" FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource AvatarMenuItem}"
                                                                Command="{Binding NavigarParaAjudaCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                                                <TextBlock Text="Ajuda" FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Border Style="{StaticResource RowSeparator}" Margin="10,5"/>
                                                        <!-- Sair (encerra o app; o X da janela só minimiza para a bandeja) -->
                                                        <Button Style="{StaticResource AvatarMenuItem}"
                                                                Command="{Binding SairCommand}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                                           Foreground="{DynamicResource DangerBrush}"
                                                                           VerticalAlignment="Center" Margin="0,0,11,0"/>
                                                                <TextBlock Text="Sair" FontSize="12.5" FontWeight="Medium"
                                                                           Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </Border>
                                        </Popup>

                                    </StackPanel>
                                </Border>

                                <!-- ── NAV ── -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,2,0,0">

                                        <TextBlock Text="TRABALHO" Style="{StaticResource EyebrowText}"
                                                   Margin="24,6,0,8"/>

                                        <!-- Início -->
                                        <Button Tag="&#xE80F;" Command="{Binding NavigarParaDashboardCommand}" Margin="0,1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaginaAtiva}" Value="dashboard">
                                                            <Setter Property="Background"   Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                                            <Setter Property="Foreground"   Value="{DynamicResource AccentTextBrush}"/>
                                                            <Setter Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Início" FontSize="12.5" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PaginaAtiva}" Value="dashboard">
                                                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Macros (expansível) -->
                                        <StackPanel>
                                            <Grid Height="40" Margin="0,1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <!-- 40 = os 26 do chevron mais os 14 de folga.
                                                         Com 34 aqui a folga da direita nao cabia, o
                                                         WPF encostava o circulo no inicio da coluna e
                                                         ele ia parar EM CIMA da curva do realce do
                                                         item: a linha saia com a quina comida e a
                                                         setinha por fora do limite. -->
                                                    <ColumnDefinition Width="40"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Botão principal Macros -->
                                                <Button Grid.Column="0" Grid.ColumnSpan="2" Tag="&#xE945;"
                                                        Command="{Binding NavigarParaMacrosCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding MacrosPaginaAtiva}" Value="True">
                                                                    <Setter Property="Background"  Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                                                    <Setter Property="Foreground"  Value="{DynamicResource AccentTextBrush}"/>
                                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="Macros" FontSize="12.5" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding MacrosPaginaAtiva}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <!-- Chevron expand/collapse: fica POR CIMA do botão de Macros,
                                                     na coluna da direita, para que a linha inteira continue
                                                     navegando e só a setinha expanda. -->
                                                <Button Grid.Column="1" Command="{Binding ToggleMacrosExpansaoCommand}"
                                                        Background="Transparent" BorderThickness="0" Cursor="Hand"
                                                        VerticalAlignment="Center" FocusVisualStyle="{x:Null}"
                                                        ToolTip="Mostrar ou esconder as seções de Macros">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <!-- Redondo, e a 14px da direita: a 10px o quadrado
                                                                 encostava na curva do realce do item e saía com
                                                                 cara de recortado. -->
                                                            <Border x:Name="chbg" CornerRadius="{StaticResource RadiusPill}"
                                                                    Background="{TemplateBinding Background}"
                                                                    Width="26" Height="26" Margin="0,0,14,0">
                                                                <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="8"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource SidebarMutedBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="&#xE76C;"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding MacrosExpandido}" Value="True">
                                                                                    <Setter Property="Text" Value="&#xE70D;"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="chbg" Property="Background"
                                                                            Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </Grid>
                                            <!-- Sub-itens de Macros -->
                                            <StackPanel Visibility="{Binding MacrosExpandido, Converter={StaticResource BoolToVis}}"
                                                        Margin="0,0,0,4">
                                                <Button Style="{StaticResource NavSubItem}" Command="{Binding NavigarParaMacrosCommand}">
                                                    <TextBlock Text="Todas as macros" FontSize="11.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaginaAtiva}" Value="macros">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                                                        <Setter Property="FontWeight"  Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Button Style="{StaticResource NavSubItem}" Command="{Binding NavigarParaCategoriasCommand}">
                                                    <TextBlock Text="Categorias" FontSize="11.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaginaAtiva}" Value="categorias">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                                                        <Setter Property="FontWeight"  Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Button Style="{StaticResource NavSubItem}" Command="{Binding NavigarParaVariaveisCommand}">
                                                    <TextBlock Text="Variáveis globais" FontSize="11.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaginaAtiva}" Value="variaveis">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                                                        <Setter Property="FontWeight"  Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                                <Button Style="{StaticResource NavSubItem}" Command="{Binding NavigarParaManualSqlCommand}">
                                                    <TextBlock Text="Manual SQL MAX" FontSize="11.5">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource SidebarMutedBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PaginaAtiva}" Value="manualsql">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                                                        <Setter Property="FontWeight"  Value="SemiBold"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Tarefas -->
                                        <Button Tag="&#xE9D5;" Command="{Binding NavigarParaTarefasCommand}" Margin="0,1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaginaAtiva}" Value="tarefas">
                                                            <Setter Property="Background"   Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                                            <Setter Property="Foreground"   Value="{DynamicResource AccentTextBrush}"/>
                                                            <Setter Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Tarefas" FontSize="12.5" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PaginaAtiva}" Value="tarefas">
                                                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Lembretes -->
                                        <Button Tag="&#xE787;" Command="{Binding NavigarParaCompromissosCommand}" Margin="0,1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaginaAtiva}" Value="compromissos">
                                                            <Setter Property="Background"   Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                                            <Setter Property="Foreground"   Value="{DynamicResource AccentTextBrush}"/>
                                                            <Setter Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Lembretes" FontSize="12.5" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PaginaAtiva}" Value="compromissos">
                                                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                        <!-- Notas -->
                                        <Button Tag="&#xE70B;" Command="{Binding NavigarParaNotasCommand}" Margin="0,1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding PaginaAtiva}" Value="notas">
                                                            <Setter Property="Background"   Value="{DynamicResource SurfaceGlassActiveBrush}"/>
                                                            <Setter Property="Foreground"   Value="{DynamicResource AccentTextBrush}"/>
                                                            <Setter Property="BorderBrush"  Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <TextBlock Text="Notas" FontSize="12.5" FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource SidebarTextBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PaginaAtiva}" Value="notas">
                                                                <Setter Property="Foreground" Value="{DynamicResource SidebarTextActiveBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>

                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Reflexo de quina do painel -->
                            <Border Style="{StaticResource GlassEdge}"/>
                        </Grid>
                    </Border>

                    <!-- ══════════════ PAINEL DE CONTEÚDO ══════════════ -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource SurfaceGlassBrush}"
                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource RadiusXl}"
                            Effect="{DynamicResource ShadowSoft}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="52"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Barra de título: transparente, faz parte do painel. Arrastar a janela
                                 continua sendo aqui. -->
                            <Grid Grid.Row="0" Margin="22,0,14,0" Background="Transparent"
                                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="SK MacroHelper" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  " FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="11.5"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               Text="{Binding StatusMensagem}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            VerticalAlignment="Center">
                                    <Button Style="{StaticResource ChromeButton}"
                                            Click="SearchButton_Click" Margin="0,0,6,0"
                                            ToolTip="Busca rápida (Ctrl+Espaço)"
                                            AutomationProperties.AutomationId="SearchButton"
                                            AutomationProperties.Name="Busca rápida">
                                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Button>
                                    <Button Style="{StaticResource ChromeButton}" Click="MinimizeButton_Click">
                                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource ChromeButton}" Click="MaximizeButton_Click" Margin="2,0">
                                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Button>
                                    <Button Click="CloseButton_Click" Width="34" Height="30"
                                            Cursor="Hand" BorderThickness="0" Background="Transparent"
                                            FocusVisualStyle="{x:Null}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bg" CornerRadius="{StaticResource RadiusSm}"
                                                        Background="{TemplateBinding Background}">
                                                    <TextBlock x:Name="glifo" Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bg" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                        <Setter TargetName="glifo" Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Style="{StaticResource RowSeparator}" Margin="1,0"/>

                            <!-- Content router -->
                            <ContentControl Grid.Row="2" Content="{Binding CurrentView}">
                                <ContentControl.Resources>
                                    <DataTemplate DataType="{x:Type vm:MacrosViewModel}">
                                        <views:MacrosView/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:ConfiguracoesViewModel}">
                                        <views:ConfiguracoesView/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:CategoriasViewModel}">
                                        <views:CategoriasView/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                                        <views:DashboardView/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:VariaveisGlobaisViewModel}">
                                        <views:VariaveisGlobaisView/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:TarefasViewModel}">
                                        <views:TarefasView/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:CompromissosViewModel}">
                                        <views:CompromissosView/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:NotasViewModel}">
                                        <views:NotasView/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:AjudaViewModel}">
                                        <views:AjudaView/>
                                    </DataTemplate>
                                    <DataTemplate DataType="{x:Type vm:ManualSqlViewModel}">
                                        <views:ManualSqlView/>
                                    </DataTemplate>
                                </ContentControl.Resources>
                            </ContentControl>

                            <!-- Página sem porta de entrada: nenhum botão, item de barra lateral
                                 ou menu leva até ela, e ela nasce recolhida. Fica na MESMA célula
                                 do roteador, por cima da página aberta, e só troca de Visibility:
                                 recriar o controle recarregaria o que está dentro dele. Ver
                                 PaginaOcultaView. -->
                            <views:PaginaOcultaView x:Name="PaginaOculta" Grid.Row="2"
                                                    Visibility="Collapsed"/>

                            <!-- Reflexo de quina do painel -->
                            <Border Grid.Row="0" Style="{StaticResource GlassEdge}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
